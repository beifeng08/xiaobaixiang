<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 构成主义·墨面：与 Light.xaml 键集一致。墨底、纸色文字、提亮的红作强调。 -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#161412"/>
    <SolidColorBrush x:Key="SurfaceBgBrush" Color="#221F1B"/>
    <SolidColorBrush x:Key="SubtleBgBrush" Color="#1B1916"/>
    <SolidColorBrush x:Key="TextBrush" Color="#EFE6D2"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B9AE98"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#4A443B"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#EFE6D2"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#E5483D"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#F2766C"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#2A2620"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#3A2420"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F2766C"/>
    <SolidColorBrush x:Key="ChartGridBrush" Color="#3A352D"/>
    <SolidColorBrush x:Key="ChartTextBrush" Color="#B9AE98"/>
    <SolidColorBrush x:Key="ChartNoDataBrush" Color="#B9AE98"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#6B6255"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#EFE6D2"/>
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#1B1916"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#3A2420"/>
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#93AAEA"/>
    <SolidColorBrush x:Key="AccentOnBrush" Color="#161412"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#1B1916"/>
    <SolidColorBrush x:Key="PosterTextBrush" Color="#EFE6D2"/>
    <LinearGradientBrush x:Key="HeroBgBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#221F1B" Offset="0"/>
        <GradientStop Color="#221F1B" Offset="0.78"/>
        <GradientStop Color="#C8261E" Offset="0.78"/>
        <GradientStop Color="#C8261E" Offset="0.86"/>
        <GradientStop Color="#C59A3E" Offset="0.86"/>
        <GradientStop Color="#C59A3E" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PosterShadeBrush" Color="Transparent"/>
    <!-- 构成主义品牌色：深浅主题共用的固定色块（海报式色面、登记窗），不随主题翻转 -->
    <SolidColorBrush x:Key="PaperBrush" Color="#EFE6D2"/>
    <SolidColorBrush x:Key="InkBrush" Color="#161412"/>
    <SolidColorBrush x:Key="PosterRedBrush" Color="#C8261E"/>
    <SolidColorBrush x:Key="PosterGoldBrush" Color="#C59A3E"/>
</ResourceDictionary>
