<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 构成主义·纸面：与 Dark.xaml 键集一致。纸底、墨线、红色强调，蓝色作第二强调。 -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#EFE6D2"/>
    <SolidColorBrush x:Key="SurfaceBgBrush" Color="#F7F1E3"/>
    <SolidColorBrush x:Key="SubtleBgBrush" Color="#E5D9BF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#161412"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5E564B"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#A89A80"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#161412"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#C8261E"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#A31E17"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#E5D9BF"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#DCCBA6"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#A31E17"/>
    <SolidColorBrush x:Key="ChartGridBrush" Color="#D8CBB0"/>
    <SolidColorBrush x:Key="ChartTextBrush" Color="#5E564B"/>
    <SolidColorBrush x:Key="ChartNoDataBrush" Color="#5E564B"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#8C7F68"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#161412"/>
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#E5D9BF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#F1D2C9"/>
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#2E4FA8"/>
    <SolidColorBrush x:Key="AccentOnBrush" Color="#EFE6D2"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#E5D9BF"/>
    <SolidColorBrush x:Key="PosterTextBrush" Color="#EFE6D2"/>
    <!-- 页眉卡：纸面上右下角一道红/墨硬边斜带（不渐变，色块直接相接） -->
    <LinearGradientBrush x:Key="HeroBgBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F7F1E3" Offset="0"/>
        <GradientStop Color="#F7F1E3" Offset="0.78"/>
        <GradientStop Color="#C8261E" Offset="0.78"/>
        <GradientStop Color="#C8261E" Offset="0.86"/>
        <GradientStop Color="#161412" Offset="0.86"/>
        <GradientStop Color="#161412" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PosterShadeBrush" Color="Transparent"/>
    <!-- 构成主义品牌色：深浅主题共用的固定色块（海报式色面、登记窗），不随主题翻转 -->
    <SolidColorBrush x:Key="PaperBrush" Color="#EFE6D2"/>
    <SolidColorBrush x:Key="InkBrush" Color="#161412"/>
    <SolidColorBrush x:Key="PosterRedBrush" Color="#C8261E"/>
    <SolidColorBrush x:Key="PosterGoldBrush" Color="#C59A3E"/>
</ResourceDictionary>
