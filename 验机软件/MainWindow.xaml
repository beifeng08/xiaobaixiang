<Window x:Class="YanJi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="笔吧验机 · 验机辅助与离线记录" Width="1220" Height="820"
        MinWidth="1040" MinHeight="700"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextElement.Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,0,3,0">
            <Grid Margin="14,18,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="8,0,4,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" HorizontalAlignment="Left"
                            Background="{DynamicResource PosterRedBrush}">
                        <TextBlock Text="验" FontSize="22" FontWeight="Black"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource PaperBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="笔吧验机" FontSize="20" FontWeight="Black"/>
                        <TextBlock Text="BIBA YANJI / 辅助核对 · 离线记录" FontSize="10" Margin="0,3,0,0"
                                   FontFamily="Bahnschrift, Microsoft YaHei UI" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="10,0,8,8">
                    <TextBlock Text="检测项目" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="ModuleCountText" HorizontalAlignment="Right" FontSize="11"
                               Foreground="{DynamicResource SecondaryAccentBrush}"/>
                </Grid>
                <!-- 插件清单驱动导航；页面常驻，保留鼠标、键盘和通过后自动切页。 -->
                <ListBox Grid.Row="2" x:Name="NavList" SelectionChanged="OnNavSelect"
                         AutomationProperties.Name="检测项目导航" Margin="0,0,0,10"/>
                <!-- 构成主义海报块：纯几何色面，不用图片；高度随侧栏余量伸缩 -->
                <Border Grid.Row="3" Margin="6,4,6,14" ClipToBounds="True" MinHeight="70"
                        Background="{DynamicResource InkBrush}">
                    <Viewbox Stretch="Uniform" VerticalAlignment="Bottom" IsHitTestVisible="False">
                        <Canvas Width="200" Height="260">
                            <Ellipse Canvas.Left="70" Canvas.Top="20" Width="150" Height="150"
                                     Fill="{DynamicResource PosterRedBrush}"/>
                            <Polygon Points="0,150 200,92 200,124 0,182" Fill="{DynamicResource PaperBrush}"/>
                            <Polygon Points="118,0 150,0 70,260 38,260" Fill="{DynamicResource PosterGoldBrush}"/>
                            <Rectangle Canvas.Left="14" Canvas.Top="24" Width="9" Height="44" Fill="{DynamicResource PaperBrush}"/>
                            <Rectangle Canvas.Left="14" Canvas.Top="76" Width="9" Height="12" Fill="{DynamicResource PaperBrush}"/>
                            <Rectangle Canvas.Left="14" Canvas.Top="96" Width="9" Height="12" Fill="{DynamicResource PaperBrush}"/>
                            <TextBlock Canvas.Left="14" Canvas.Top="196" Text="认真验机，" FontSize="17" FontWeight="Black"
                                       Foreground="{DynamicResource PaperBrush}"/>
                            <TextBlock Canvas.Left="14" Canvas.Top="220" Text="留下证据。" FontSize="17" FontWeight="Black"
                                       Foreground="{DynamicResource PosterRedBrush}"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel Grid.Row="4" Margin="10,0,10,0">
                    <Grid Margin="0,0,0,9">
                        <TextBlock Text="本次完成" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="CompletionText" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/>
                    </Grid>
                    <ProgressBar x:Name="CompletionProgress" Height="4" Maximum="1"/>
                    <TextBlock x:Name="AllDoneHint" Text="全部验机项目已完成" FontSize="11"
                               TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"
                               Foreground="{DynamicResource SecondaryAccentBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,0,0,3" Padding="24,17">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="BIBA YANJI / 检测工作台" Style="{StaticResource PageEyebrow}"/>
                        <TextBlock x:Name="CurrentModuleText" Text="欢迎使用笔吧验机" FontSize="22"
                                   FontWeight="Black" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="OnIntakeClick" Padding="13,8" Margin="0,0,8,0"
                                ToolTip="录入或修改订单 / 卖家描述里的已知配置，报告里会并排对照" AutomationProperties.Name="已知信息">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                <TextBlock Text="已知信息"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnExportClick" Padding="13,8" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}"
                                ToolTip="导出验机报告（JSON + 网页），并在浏览器打开" AutomationProperties.Name="导出报告">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                <TextBlock Text="导出报告"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnPluginManagerClick" Padding="13,8" Margin="0,0,18,0"
                                ToolTip="查看、导入或删除插件模块" AutomationProperties.Name="插件管理">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                <TextBlock Text="插件管理"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ToggleButton x:Name="ThemeSwitch" Style="{StaticResource ThemeSwitch}"
                                      ToolTip="切换深色 / 浅色主题" AutomationProperties.Name="切换深浅主题"
                                      Checked="OnThemeSwitch" Unchecked="OnThemeSwitch"/>
                        <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <ContentControl x:Name="ContentHost" Grid.Row="1" HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,2,0,0"
                    Padding="24,9" Background="{DynamicResource SubtleBgBrush}">
                <TextBlock x:Name="ModuleHintText" Text="选择左侧项目开始检测" FontSize="11"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
