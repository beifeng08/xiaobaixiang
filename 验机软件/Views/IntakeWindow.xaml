<Window x:Class="YanJi.Views.IntakeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="验机前登记" Width="680" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource InkBrush}" Foreground="{DynamicResource PaperBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <StackPanel>
        <!-- 登记窗反转主界面配色：墨底纸字，红色斜切页眉 -->
        <Grid Height="118" ClipToBounds="True">
            <Polygon Points="0,0 680,0 680,64 0,118" Fill="{DynamicResource PosterRedBrush}"/>
            <Polygon Points="470,0 560,0 380,118 290,118" Fill="{DynamicResource PosterGoldBrush}"/>
            <Ellipse Width="150" Height="150" Margin="0,-40,-30,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Stroke="{DynamicResource InkBrush}" StrokeThickness="18"/>
            <StackPanel Margin="28,16,0,0">
                <TextBlock Text="REGISTER · 验机前登记" FontFamily="Bahnschrift, Microsoft YaHei UI" FontSize="12"
                           FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                <TextBlock Text="先写下你已知的配置" FontSize="26" FontWeight="Black" Margin="0,4,0,0"
                           Foreground="{DynamicResource PaperBrush}"/>
            </StackPanel>
        </Grid>

        <TextBlock Margin="28,10,28,14" TextWrapping="Wrap" Opacity=".8"
                   Text="填订单、商品页或卖家描述里的配置；不知道的留空。报告会把这里的内容与实际采集值并排列出，是否一致由你判断，软件不自动下结论。"/>

        <ItemsControl x:Name="FieldList" Margin="28,0,28,0" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource PosterGoldBrush}" Height="30" VerticalAlignment="Top">
                            <TextBlock Text="{Binding No}" FontFamily="Bahnschrift, Consolas" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource InkBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="Bold" Margin="12,6,8,0"/>
                        <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding Hint}" AutomationProperties.Name="{Binding Label}"
                                 AcceptsReturn="{Binding Multiline}" TextWrapping="Wrap" MaxLength="400"
                                 MinHeight="30" Padding="8,5"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Margin="28,10,28,24">
            <TextBlock VerticalAlignment="Center" Opacity=".65" FontSize="12"
                       Text="可随时在顶栏「已知信息」里修改"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="跳过" Padding="18,8" Margin="0,0,10,0" IsCancel="True" Click="Skip_Click"/>
                <Button Content="开始验机" Padding="22,8" IsDefault="True" Click="Start_Click"
                        Style="{DynamicResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
