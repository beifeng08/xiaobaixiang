ls:c,click_urls:c,track_id:b,feedback_panel:c,sales_type:a,wx_program_info:c,list_type:a,crowd_id:a,pc_style:a},{id:1792397,contract_id:b,res_id:u,asg_id:1731754,pos_num:8,name:c_,pic:"http:\u002F\u002Fi0.hdslb.com\u002Fbfs\u002Fbanner\u002Fff56fcfad8a53084cb2ab7ed3e3cff110f81a1d1.png",image_urls:c,litpic:"#0E1B37",url:"http:\u002F\u002Fwww.bilibili.com\u002Fvideo\u002FBV1aLp16uEFB?track_id=",style:a,archive:{aid:c$,videos:d,tid:cS,tname:ae,copyright:v,pic:"http:\u002F\u002Fi1.hdslb.com\u002Fbfs\u002Farchive\u002F677416dcdfef801aaf64f6ebe8b8565aeff11432.jpg",title:c_,pubdate:1791982583,ctime:1791982584,desc:"从《2012》《三体》到超新星与黑洞，中微子总以“宇宙幽灵”的形象出现。它几乎能穿透一切，却携带着恒星死亡与遥远星系的秘密。\n70年前，科学家在核反应堆旁第一次捕获它；此后，太阳中微子之谜、超新星SN 1987A、中微子振荡，接连改写人类对宇宙的认识。\n如今，2026年诺贝尔物理学奖得主哈尔岑，在南极一立方千米的冰层里，布下5160只“眼睛”，追寻来自数十亿光年外的幽灵信使。\n它不是灾难的制造者，而是宇宙灾难的见证者。\n仰望无边星海，人类如此渺小，却为何依然敢于凝视深渊？",state:a,duration:1007,mission_id:cT,rights:{bp:a,elec:a,download:a,movie:a,pay:a,hd5:a,no_reprint:a,autoplay:d,ugc_pay:a,is_cooperation:a,ugc_pay_preview:a,no_background:a,arc_pay:a,pay_free_watch:a},owner:{mid:670400594,name:"艾栗夏",face:"https:\u002F\u002Fi2.hdslb.com\u002Fbfs\u002Fface\u002Fa2f5b1d02daabb166d55bb78ef8a467af8e8e9bd.jpg"},stat:{aid:c$,view:da,danmaku:123,reply:351,favorite:2299,coin:1429,share:117,now_rank:a,his_rank:a,like:3350,dislike:a,vt:a,vv:da,fav_g:248,like_g:198},dynamic:"小时候看2012，看到变异中微子导致世界末日，给我吓得不行，但我爸说不可能，中微子没那个功能……我不信，因为没人请我爸拍电影……科幻作品里中微子总是与“末日”同行，现实中，人类却在全球建起了中微子天文台……动物的本能是逃离危险，人类的本能却是凝视深渊。也许这恰恰是我们幸存的理由。",cid:42777380745,dimension:{width:1920,height:1080,rotate:a},season_id:cV,short_link_v2:"https:\u002F\u002Fb23.tv\u002FBV1aLp16uEFB",first_frame:"http:\u002F\u002Fi0.hdslb.com\u002Fbfs\u002Fstoryff\u002F_000035gt3g87ydvx62kcm0rq431wvub_firsti.jpg",pub_location:"澳大利亚",cover43:"http:\u002F\u002Fi1.hdslb.com\u002Fbfs\u002Farchive\u002F7f34d6154dd99400edf7934938756f174912ffad.jpg",tidv2:cW,tnamev2:ae,pid_v2:cX,pid_name_v2:cY,attribute_v3:ad,current_state:a,global_state:a,bvid:"BV1aLp16uEFB",enable