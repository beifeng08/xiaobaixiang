<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>YanJi.Plugin.ConfigCheck</AssemblyName>
    <RootNamespace>YanJi.Plugin.ConfigCheck</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    
    <ProjectReference Include="..\..\PluginSdk\YanJi.PluginSdk.csproj" Private="false" />
    
    <ProjectReference Include="..\..\LibreHardwareMonitor-master\LibreHardwareMonitorLib\LibreHardwareMonitorLib.csproj"
                      SetPlatform="Platform=x64" />
  </ItemGroup>

  <ItemGroup>
    
    <PackageReference Include="System.Management" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\LhmComputerAccess.cs" Link="LhmComputerAccess.cs" />
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
