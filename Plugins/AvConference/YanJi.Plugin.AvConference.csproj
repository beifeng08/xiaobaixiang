<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 19041：摄像头用 WinRT Windows.Media.Capture（Windows 自带，无第三方依赖），需要 Windows SDK 目标 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 类库默认不把 NuGet 依赖拷到输出；插件目录需自含依赖（NAudio/HidSharp/DiskInfoToolkit 等），
         运行时由宿主的依赖解析兜底钩子从插件目录加载（System.Management 桩除外：宿主 TPA 优先解析到真实实现） -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>YanJi.Plugin.AvConference</AssemblyName>
    <RootNamespace>YanJi.Plugin.AvConference</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 插件契约由宿主提供：Private=false 不把 YanJi.PluginSdk.dll 拷进插件目录，运行时与宿主共享同一类型 -->
    <ProjectReference Include="..\..\PluginSdk\YanJi.PluginSdk.csproj" Private="false" />
    <!-- 麦克风/扬声器（WASAPI 设备枚举、电平、录制、播放）：Ms-PL 开源协议 -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
