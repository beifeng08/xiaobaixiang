avx512_fma_fac MACRO fac_size

	vbroadcastsd zmm28, QWORD PTR ZMM_FMA_RND_CONST0	
	yfmaddpd zmm0, zmm2, zmm2, zmm28			
	yfmaddpd zmm7, zmm9, zmm9, zmm28			
	yfmaddpd zmm14, zmm16, zmm16, zmm28			
	yfmaddpd zmm21, zmm23, zmm23, zmm28			

	vbroadcastsd zmm29, QWORD PTR ZMM_FMA_RND_CONST1	
	yfmaddpd zmm1, zmm2, zmm3, zmm29			
	yfmaddpd zmm8, zmm9, zmm10, zmm29			
	yfmaddpd zmm15, zmm16, zmm17, zmm29			
	yfmaddpd zmm22, zmm23, zmm24, zmm29			

	vsubpd	zmm0, zmm0, zmm28				
	vsubpd	zmm7, zmm7, zmm28				
	vsubpd	zmm14, zmm14, zmm28				
	vsubpd	zmm21, zmm21, zmm28				

	vsubpd	zmm1, zmm1, zmm29				
	vsubpd	zmm8, zmm8, zmm29				
	vsubpd	zmm15, zmm15, zmm29				
	vsubpd	zmm22, zmm22, zmm29				

	yfmsubpd zmm4, zmm2, zmm2, zmm0				
	yfmsubpd zmm11, zmm9, zmm9, zmm7			
	yfmsubpd zmm18, zmm16, zmm16, zmm14			
	yfmsubpd zmm25, zmm23, zmm23, zmm21			

	mov	edx, FMA_SHIFTER[rdi*4-4]			

	yfmaddpd zmm5, zmm0, ZMMWORD PTR ZMM_FMA_TWOPOW1_MODF_HI[rdx], zmm29
								
	yfmaddpd zmm12, zmm7, ZMMWORD PTR ZMM_FMA_TWOPOW1_MODF_HIa[rdx], zmm29
								
	yfmaddpd zmm19, zmm14, ZMMWORD PTR ZMM_FMA_TWOPOW1_MODF_HIb[rdx], zmm29
								
	yfmaddpd zmm26, zmm21, ZMMWORD PTR ZMM_FMA_TWOPOW1_MODF_HIc[rdx], zmm29
								
	vmovapd	zmm28, ZMMWORD PTR ZMM_FMA_TWO
	yfmaddpd zmm4, zmm28, zmm1, zmm4			
	yfmaddpd zmm11, zmm28, zmm8, zmm11			
	yfmaddpd zmm18, zmm28, zmm15, zmm18			
	yfmaddpd zmm25, zmm28, zmm22, zmm25			

	vsubpd	zmm5, zmm5, zmm29				
	vsubpd	zmm12, zmm12, zmm29				
	vsubpd	zmm19, zmm19, zmm29				
	vsubpd	zmm26, zmm26, zmm29				

	yfmsubpd zmm2, zmm2, zmm3, zmm1				
	yfmsubpd zmm9, zmm9, zmm10, zmm8			
	yfmsubpd zmm16, zmm16, zmm17, zmm15			
	yfmsubpd zmm23, zmm23, zmm24, zmm22			

	vmovapd zmm29, ZMMWORD PTR [r13][rdx]			
	yfmaddpd zmm4, zmm29, zmm4, zmm5			
	yfmaddpd zmm11, zmm29, zmm11, zmm12			
	yfmaddpd zmm18, zmm29, zmm18, zmm19			
	yfmaddpd zmm25, zmm29, zmm25, zmm26			

