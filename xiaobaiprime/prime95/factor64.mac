	yfnmaddpd ymm10, ymm14, YMMWORD PTR YMM_FMA_FAC_HIb, ymm10

	yfnmaddpd ymm0, ymm12, YMMWORD PTR YMM_FMA_FAC_LO, ymm15
	yfnmaddpd ymm4, ymm13, YMMWORD PTR YMM_FMA_FAC_LOa, ymm15
	yfnmaddpd ymm8, ymm14, YMMWORD PTR YMM_FMA_FAC_LOb, ymm15

 	vaddpd	ymm2, ymm1, ymm2				
 	vaddpd	ymm6, ymm5, ymm6				
 	vaddpd	ymm10, ymm9, ymm10				

	vmovapd ymm1, YMMWORD PTR YMM_FMA_SAVE2			
	vmovapd ymm5, YMMWORD PTR YMM_FMA_SAVE2a		
	vmovapd ymm9, YMMWORD PTR YMM_FMA_SAVE2b		

	yfmsubpd ymm1, ymm1, YMMWORD PTR YMM_FMA_TWOPOW1_MODF_LO[rdx], ymm3
	yfmsubpd ymm5, ymm5, YMMWORD PTR YMM_FMA_TWOPOW1_MODF_LOa[rdx], ymm7
	yfmsubpd ymm9, ymm9, YMMWORD PTR YMM_FMA_TWOPOW1_MODF_LOb[rdx], ymm11

	vsubpd	ymm0, ymm0, ymm15				
	vsubpd	ymm4, ymm4, ymm15				
	vsubpd	ymm8, ymm8, ymm15				

	vmovapd ymm15, YMMWORD PTR [r8][rdx]			
	yfmaddpd ymm1, ymm15, YMMWORD PTR YMM_FMA_SAVE, ymm1	
	yfmaddpd ymm5, ymm15, YMMWORD PTR YMM_FMA_SAVEa, ymm5	
	yfmaddpd ymm9, ymm15, YMMWORD PTR YMM_FMA_SAVEb, ymm9	

	vaddpd	ymm2, ymm2, ymm3				
	vaddpd	ymm6, ymm6, ymm7				
	vaddpd	ymm10, ymm10, ymm11				

	yfnmsubpd ymm12, ymm12, YMMWORD PTR YMM_FMA_FAC_LO, ymm0
	yfnmsubpd ymm13, ymm13, YMMWORD PTR YMM_FMA_FAC_LOa, ymm4
	yfnmsubpd ymm14, ymm14, YMMWORD PTR YMM_FMA_FAC_LOb, ymm8

	vaddpd	ymm2, ymm2, ymm0				
	vaddpd	ymm6, ymm6, ymm4				
	vaddpd	ymm10, ymm10, ymm8				

	vaddpd	ymm3, ymm1, ymm12				
	vaddpd	ymm7, ymm5, ymm13				
	vaddpd	ymm11, ymm9, ymm14				
	ENDM

