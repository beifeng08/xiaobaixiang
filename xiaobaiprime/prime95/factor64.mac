sse2_fac MACRO fac_size

	IF fac_size GE 75
	movdqa	xmm3, xmm0		
	movdqa	xmm4, xmm0		
	pmuludq	xmm0, xmm0		
	movdqa	xmm5, xmm1		
	pmuludq	xmm1, xmm1		
	pmuludq	xmm3, xmm2		
	pmuludq	xmm4, xmm5		
	pmuludq	xmm5, xmm2		
	movdqa	xmm6, xmm0		
	psrlq	xmm0, 30		
	movdqa	xmm7, XMMWORD PTR XMM_TWO_120_MODF2
	pmuludq	xmm7, xmm0		
	paddq	xmm1, xmm7		
	movdqa	xmm7, XMMWORD PTR XMM_TWO_120_MODF1
	pmuludq	xmm7, xmm0		
	psllq	xmm3, 1			
	pmuludq	xmm0, XMMWORD PTR XMM_TWO_120_MODF3
					
	psllq	xmm4, 1			
	pmuludq	xmm2, xmm2		
	psllq	xmm5, 1			
	pand	xmm6, XMMWORD PTR XMM_BITS30
					
	paddq	xmm4, xmm7		
	paddq	xmm5, xmm0		
	paddq	xmm1, xmm3		
					
	movdqa	xmm0, xmm1		
	psrlq	xmm1, 30		
	paddq	xmm4, xmm1		
	pand	xmm0, XMMWORD PTR XMM_BITS30
					
	movdqa	xmm3, xmm4		
	psrlq	xmm4, 30		
	paddd	xmm6, xmm4		
					
	movdqa	xmm7, XMMWORD PTR XMM_TWO_120_MODF2
	pmuludq	xmm7, xmm6		
	pand	xmm3, XMMWORD PTR XMM_BITS30
					
	movdqa	xmm1, XMMWORD PTR XMM_TWO_120_MODF1
	pmuludq	xmm1, xmm6		
	psllq	xmm3, 30		
	pmuludq	xmm6, XMMWORD PTR XMM_TWO_120_MODF3
					
	por	xmm0, xmm3		
	paddq	xmm5, xmm7		
	paddq	xmm0, xmm1		
	paddq	xmm2, xmm6		
					
	movdqa	xmm7, XMMWORD PTR XMM_BITS30
	pand	xmm7, xmm5		
	psrlq	xmm5, 30		
	paddq	xmm0, xmm5		
	psllq	xmm7, 30		
	paddq	xmm7, xmm2		
					
	ENDIF

	IF fac_size LT 75
	movdqa	xmm3, xmm0		
	movdqa	xmm4, xmm0		
	pmuludq	xmm0, xmm2		
	movdqa	xmm5, xmm1		
	pmuludq	xmm1, xmm1		
	pmuludq	xmm3, xmm3		
	pmuludq	xmm4, xmm5		
	psllq	xmm0, 1			
	pmuludq	xmm5, xmm2		
	paddq	xmm1, xmm0		
	pmuludq	xmm2, xmm2		
	psllq	xmm4, 1			
	psllq	xmm5, 1			
					
	movdqa	xmm0, xmm1		
	psrlq	xmm1, 30		
	paddq	xmm4, xmm1		
	pand	xmm0, XMMWORD PTR XMM_BITS30
					
	movdqa	xmm6, xmm4		
	psrlq	xmm4, 30		
	paddd	xmm3, xmm4		
					
	movdqa	xmm7, XMMWORD PTR XMM_TWO_120_MODF2
	pmuludq	xmm7, xmm3		
	pand	xmm6, XMMWORD PTR XMM_BITS30
					
	movdqa	xmm1, XMMWORD PTR XMM_TWO_120_MODF1
	pmuludq	xmm1, xmm3		
	psllq	xmm6, 30		
	pmuludq	xmm3, XMMWORD PTR XMM_TWO_120_MODF3
					
	por	xmm0, xmm6		
	paddq	xmm5, xmm7		
	paddq	xmm0, xmm1		
	paddq	xmm2, xmm3		
					
	movdqa	xmm7, XMMWORD PTR XMMWORD PTR XMM_BITS30
	pand	xmm7, xmm5		
	psrlq	xmm5, 30		
	paddq	xmm0, xmm5		
	psllq	xmm7, 30		
	paddq	xmm7, xmm2		
					
	ENDIF

	movdqa	xmm6, xmm0		

	psrlq	xmm0, 30		
	movdqa	xmm1, XMMWORD PTR XMM_I2
	pmuludq	xmm1, xmm0		
	movdqa	xmm3, XMMWORD PTR XMM_I1
	pmuludq	xmm0, xmm3		
	pand	xmm6, XMMWORD PTR XMM_BITS30
					
	pmuludq	xmm3, xmm6		
	paddq	xmm1, xmm3		
	psrlq	xmm1, 30		
	paddq	xmm0, xmm1		

	movd	xmm2, XMM_BS
	psrlq	xmm0, xmm2		
	movdqa	xmm1, XMMWORD PTR XMM_BITS30
	pand	xmm1, xmm0		
	psrlq	xmm0, 30		

	movdqa	xmm3, XMMWORD PTR XMM_F2
	pmuludq	xmm3, xmm1		
	movdqa	xmm4, XMMWORD PTR XMM_F3
	pmuludq	xmm4, xmm0		
	movdqa	xmm5, XMMWORD PTR XMM_F1
	pmuludq	xmm5, xmm1		
	pmuludq	xmm0, XMMWORD PTR XMM_F2
	pmuludq	xmm1, XMMWORD PTR XMM_F3
	paddq	xmm3, xmm4		
	paddd	xmm5, xmm0		
	movdqa	xmm2, XMMWORD PTR XMM_BITS30
	pand	xmm2, xmm3		
	psllq	xmm2, 30		
	paddq	xmm1, xmm2		
	psrlq	xmm3, 30		
	paddd	xmm5, xmm3		

	psubq	xmm7, xmm1		
	psubd	xmm6, xmm5		

	movd	xmm1, XMM_SHIFTER[rdi*8]
	psllq	xmm6, xmm1		
	psllq	xmm7, xmm1		

	movdqa	xmm1, XMMWORD PTR XMM_BITS30	
	movdqa	xmm2, xmm7		
	psrlq	xmm7, 30		
	pand	xmm1, xmm7		
	psrlq	xmm7, 2			
	psrad	xmm7, 28		
	paddd	xmm6, xmm7		
	pand	xmm2, XMMWORD PTR XMM_BITS30
					
	movdqa	xmm0, XMMWORD PTR XMM_BITS28	
	pand	xmm0, xmm6		
	ENDM

sse2_fac_initval MACRO
	LOCAL	retry, ok1, ok2

retry:	movdqa	xmm7, XMMWORD PTR XMM_INVFAC 
	psrlq	xmm7, 3			
	movdqa	xmm6, XMMWORD PTR XMM_BITS30
	pand	xmm6, xmm7		
	psrlq	xmm7, 30		
	movdqa	XMMWORD PTR XMM_I2, xmm6
	movdqa	XMMWORD PTR XMM_I1, xmm7

	movdqa	xmm3, XMMWORD PTR XMM_F2
	pmuludq	xmm3, xmm6		
	movdqa	xmm4, XMMWORD PTR XMM_F3
	pmuludq	xmm4, xmm7		
	movdqa	xmm5, XMMWORD PTR XMM_F1
	pmuludq	xmm5, xmm6		
	pmuludq	xmm7, XMMWORD PTR XMM_F2
	pmuludq	xmm6, XMMWORD PTR XMM_F3
	paddq	xmm3, xmm4		
	paddd	xmm5, xmm7		
	movdqa	xmm2, XMMWORD PTR XMM_BITS30
	pand	xmm2, xmm3		
	psllq	xmm2, 30		
	paddq	xmm6, xmm2		
	psrlq	xmm3, 30		
	paddd	xmm5, xmm3		

	psrlq	xmm6, 60
	paddd	xmm5, xmm6		

	psllq	xmm5, 4			
	pmovmskb edx, xmm5
	test	edx, 0008h		
	jnz	short ok1		
	movdqa	xmm7, XMMWORD PTR XMM_INVFAC 
	psubq	xmm7, XMMWORD PTR XMM_LOWONE
	movdqa	XMMWORD PTR XMM_INVFAC, xmm7
	jmp	retry			
ok1:	test	edx, 0800h		
	jnz	short ok2		
	movdqa	xmm7, XMMWORD PTR XMM_INVFAC 
	psubq	xmm7, XMMWORD PTR XMM_HIGHONE
	movdqa	XMMWORD PTR XMM_INVFAC, xmm7
	jmp	retry			
ok2:

	movdqa	xmm7, XMMWORD PTR XMM_INVFAC 
	movd	xmm0, XMM_INIT120BS
	psrlq	xmm7, xmm0		
	movdqa	xmm6, XMMWORD PTR XMM_BITS30
	pand	xmm6, xmm7		
	psrlq	xmm7, 30		

	movdqa	xmm3, XMMWORD PTR XMM_F2
	pmuludq	xmm3, xmm6		
	movdqa	xmm4, XMMWORD PTR XMM_F3
	pmuludq	xmm4, xmm7		
	movdqa	xmm5, XMMWORD PTR XMM_F1
	pmuludq	xmm5, xmm6		
	pmuludq	xmm7, XMMWORD PTR XMM_F2
	pmuludq	xmm6, XMMWORD PTR XMM_F3
	paddq	xmm3, xmm4		
	paddd	xmm5, xmm7		
	movdqa	xmm2, XMMWORD PTR XMM_BITS30
	pand	xmm2, xmm3		
	psllq	xmm2, 30		
	paddq	xmm6, xmm2		
	psrlq	xmm3, 30		
	paddd	xmm5, xmm3		

	pxor	xmm1, xmm1
	pxor	xmm0, xmm0
	psubq	xmm1, xmm6		
	psubd	xmm0, xmm5		

	movdqa	xmm4, XMMWORD PTR XMM_BITS30	
	movdqa	xmm5, xmm1		
	psrlq	xmm1, 30		
	pand	xmm4, xmm1		
	psrlq	xmm1, 2			
	psrad	xmm1, 28		
	paddd	xmm0, xmm1		
	pand	xmm5, XMMWORD PTR XMM_BITS30	
	pand	xmm0, XMMWORD PTR XMM_BITS28	
	movdqa	XMMWORD PTR XMM_TWO_120_MODF2, xmm4
	movdqa	XMMWORD PTR XMM_TWO_120_MODF3, xmm5
	movdqa	XMMWORD PTR XMM_TWO_120_MODF1, xmm0

	movdqa	xmm0, XMMWORD PTR XMM_INVFAC	
	movd	xmm1, XMM_INITBS
	psrlq	xmm0, xmm1		
	movdqa	xmm1, XMMWORD PTR XMM_BITS30
	pand	xmm1, xmm0		
	psrlq	xmm0, 30		

	movdqa	xmm6, XMMWORD PTR XMM_INITVAL	
	pxor	xmm7, xmm7		

	movdqa	xmm3, XMMWORD PTR XMM_F2
	pmuludq	xmm3, xmm1		
	movdqa	xmm4, XMMWORD PTR XMM_F3
	pmuludq	xmm4, xmm0		
	movdqa	xmm5, XMMWORD PTR XMM_F1
	pmuludq	xmm5, xmm1		
	pmuludq	xmm0, XMMWORD PTR XMM_F2
	pmuludq	xmm1, XMMWORD PTR XMM_F3
	paddq	xmm3, xmm4		
	paddd	xmm5, xmm0		
	movdqa	xmm2, XMMWORD PTR XMM_BITS30
	pand	xmm2, xmm3		
	psllq	xmm2, 30		
	paddq	xmm1, xmm2		
	psrlq	xmm3, 30		
	paddd	xmm5, xmm3		

	psubq	xmm7, xmm1		
	psubd	xmm6, xmm5		

	movdqa	xmm1, XMMWORD PTR XMM_BITS30	
	movdqa	xmm2, xmm7		
	psrlq	xmm7, 30		
	pand	xmm1, xmm7		
	psrlq	xmm7, 2			
	psrad	xmm7, 28		
	paddd	xmm6, xmm7		
	pand	xmm2, XMMWORD PTR XMM_BITS30	
	movdqa	xmm0, XMMWORD PTR XMM_BITS28	
	pand	xmm0, xmm6		
	ENDM

sse2_fac_initval MACRO
	LOCAL	retry, invfac_ok, invfac_adjust

	movdqa	xmm15, XMMWORD PTR XMM_BITS30

	movdqa	xmm1, XMMWORD PTR XMM_INVFAC 
	movdqa	xmm7, XMMWORD PTR XMM_INVFACa 
retry:	movdqa	xmm3, xmm1
	psrlq	xmm3, 3			
	movdqa	xmm0, xmm3
	pand	xmm0, xmm15		
	psrlq	xmm3, 30		
	movdqa	XMMWORD PTR XMM_I2, xmm0
	movdqa	XMMWORD PTR XMM_I1, xmm3

	movdqa	xmm9, xmm7
	psrlq	xmm9, 3			
	movdqa	xmm6, xmm9
	pand	xmm6, xmm15		
	psrlq	xmm9, 30		
	movdqa	XMMWORD PTR XMM_I2a, xmm6
	movdqa	XMMWORD PTR XMM_I1a, xmm9

	movdqa	xmm4, xmm3
	pmuludq xmm4, XMMWORD PTR XMM_F3 
	movdqa	xmm2, xmm0
	pmuludq xmm2, XMMWORD PTR XMM_F2 
	pmuludq xmm3, XMMWORD PTR XMM_F2 
	movdqa	xmm5, xmm0
	pmuludq xmm5, XMMWORD PTR XMM_F1 
	pmuludq xmm0, XMMWORD PTR XMM_F3 
	paddq	xmm4, xmm2		
	paddd	xmm3, xmm5		
	movdqa	xmm5, xmm4
	pand	xmm5, xmm15		
	psrlq	xmm4, 30		
	psllq	xmm5, 30		
	paddq	xmm0, xmm5		
	paddd	xmm3, xmm4		

	movdqa	xmm10, xmm9
	pmuludq xmm10, XMMWORD PTR XMM_F3a 
	movdqa	xmm8, xmm6
	pmuludq xmm8, XMMWORD PTR XMM_F2a 
	pmuludq xmm9, XMMWORD PTR XMM_F2a 
	movdqa	xmm11, xmm6
	pmuludq xmm11, XMMWORD PTR XMM_F1a 
	pmuludq xmm6, XMMWORD PTR XMM_F3a 
	paddq	xmm10, xmm8		
	paddd	xmm9, xmm11		
	movdqa	xmm11, xmm10
	pand	xmm11, xmm15		
	psrlq	xmm10, 30		
	psllq	xmm11, 30		
	paddq	xmm6, xmm11		
	paddd	xmm9, xmm10		

	psrlq	xmm0, 60
	paddd	xmm3, xmm0		

	psrlq	xmm6, 60
	paddd	xmm9, xmm6		

	pand	xmm3, XMMWORD PTR YMM_28TH_BIT 
	pxor	xmm2, xmm2
	pcmpeqd xmm3, xmm2		
	pand	xmm9, XMMWORD PTR YMM_28TH_BIT 
	pcmpeqd xmm9, xmm2		
	pmovmskb rdx, xmm3
	and	edx, 0F0Fh		
	jnz	short invfac_adjust	
	pmovmskb rdx, xmm9
	and	edx, 0F0Fh		
	jz	short invfac_ok		
invfac_adjust:
	psllq	xmm3, 32		
	movdqa	xmm2, xmm3
	psrlq	xmm3, 32
	por	xmm3, xmm2
	psllq	xmm9, 32		
	movdqa	xmm2, xmm9
	psrlq	xmm9, 32
	por	xmm9, xmm2
	movdqa	xmm1, XMMWORD PTR XMM_INVFAC 
	paddq	xmm1, xmm3		
	movdqa	XMMWORD PTR XMM_INVFAC, xmm1 
	movdqa	xmm7, XMMWORD PTR XMM_INVFACa 
	paddq	xmm7, xmm9		
	movdqa	XMMWORD PTR XMM_INVFACa, xmm7 
	jmp	retry			
invfac_ok:

	movdqa	xmm3, XMMWORD PTR XMM_INVFAC 
	psrlq	xmm3, XMMWORD PTR XMM_INIT120BS 
	movdqa	xmm0, xmm3
	pand	xmm0, xmm15		
	psrlq	xmm3, 30		

	movdqa	xmm9, XMMWORD PTR XMM_INVFACa 
	psrlq	xmm9, XMMWORD PTR XMM_INIT120BS 
	movdqa	xmm6, xmm9
	pand	xmm6, xmm15		
	psrlq	xmm9, 30		

	movdqa	xmm4, xmm3
	pmuludq xmm4, XMMWORD PTR XMM_F3 
	movdqa	xmm2, xmm0
	pmuludq xmm2, XMMWORD PTR XMM_F2 
	pmuludq xmm3, XMMWORD PTR XMM_F2 
	movdqa	xmm5, xmm0
	pmuludq xmm5, XMMWORD PTR XMM_F1 
	pmuludq xmm0, XMMWORD PTR XMM_F3 
	paddq	xmm4, xmm2		
	paddd	xmm3, xmm5		
	movdqa	xmm5, xmm4
	pand	xmm5, xmm15		
	psrlq	xmm4, 30		
	psllq	xmm5, 30		
	paddq	xmm0, xmm5		
	paddd	xmm3, xmm4		

	movdqa	xmm10, xmm9
	pmuludq xmm10, XMMWORD PTR XMM_F3a 
	movdqa	xmm8, xmm6
	pmuludq xmm8, XMMWORD PTR XMM_F2a 
	pmuludq xmm9, XMMWORD PTR XMM_F2a 
	movdqa	xmm11, xmm6
	pmuludq xmm11, XMMWORD PTR XMM_F1a 
	pmuludq xmm6, XMMWORD PTR XMM_F3a 
	paddq	xmm10, xmm8		
	paddd	xmm9, xmm11		
	movdqa	xmm11, xmm10
	pand	xmm11, xmm15		
	psrlq	xmm10, 30		
	psllq	xmm11, 30		
	paddq	xmm6, xmm11		
	paddd	xmm9, xmm10		

	pxor	xmm5, xmm5
	pxor	xmm4, xmm4
	psubq	xmm5, xmm0		
	psubd	xmm4, xmm3		

	pxor	xmm11, xmm11
	pxor	xmm10, xmm10
	psubq	xmm11, xmm6		
	psubd	xmm10, xmm9		

	movdqa	xmm2, xmm5
	pand	xmm2, xmm15		
	psrlq	xmm5, 30		
	movdqa	xmm1, xmm5
	pand	xmm1, xmm15		
	psrlq	xmm5, 2			
	psrad	xmm5, 28		
	paddd	xmm4, xmm5		
	movdqa	xmm0, xmm4
	pand	xmm0, XMMWORD PTR XMM_BITS28 
	movdqa XMMWORD PTR XMM_TWO_120_MODF3, xmm2
	movdqa XMMWORD PTR XMM_TWO_120_MODF2, xmm1
	movdqa XMMWORD PTR XMM_TWO_120_MODF1, xmm0

	movdqa	xmm8, xmm11
	pand	xmm8, xmm15		
	psrlq	xmm11, 30		
	movdqa	xmm7, xmm11
	pand	xmm7, xmm15		
	psrlq	xmm11, 2		
	psrad	xmm11, 28		
	paddd	xmm10, xmm11		
	movdqa	xmm6, xmm10
	pand	xmm6, XMMWORD PTR XMM_BITS28 
	movdqa XMMWORD PTR XMM_TWO_120_MODF3a, xmm8
	movdqa XMMWORD PTR XMM_TWO_120_MODF2a, xmm7
	movdqa XMMWORD PTR XMM_TWO_120_MODF1a, xmm6

	movdqa	xmm0, XMMWORD PTR XMM_INVFAC 
	movd	xmm1, XMM_INITBS
	psrlq	xmm0, xmm1		
	movdqa	xmm3, xmm0
	psrlq	xmm3, 30		
	pand	xmm0, xmm15		

	movdqa	xmm6, XMMWORD PTR XMM_INVFACa 
	psrlq	xmm6, xmm1		
	movdqa	xmm9, xmm6
	psrlq	xmm9, 30		
	pand	xmm6, xmm15		

	movdqa	xmm4, xmm3
	pmuludq xmm4, XMMWORD PTR XMM_F3 
	movdqa	xmm2, xmm0
	pmuludq xmm2, XMMWORD PTR XMM_F2 
	pmuludq xmm3, XMMWORD PTR XMM_F2 
	movdqa	xmm5, xmm0
	pmuludq xmm5, XMMWORD PTR XMM_F1 
	pmuludq xmm0, XMMWORD PTR XMM_F3 
	paddq	xmm4, xmm2		
	paddd	xmm3, xmm5		
	movdqa	xmm5, xmm4
	pand	xmm5, xmm15		
	psrlq	xmm4, 30		
	psllq	xmm5, 30		
	paddq	xmm0, xmm5		
	paddd	xmm3, xmm4		

	movdqa	xmm10, xmm9
	pmuludq xmm10, XMMWORD PTR XMM_F3a 
	movdqa	xmm8, xmm6
	pmuludq xmm8, XMMWORD PTR XMM_F2a 
	pmuludq xmm9, XMMWORD PTR XMM_F2a 
	movdqa	xmm11, xmm6
	pmuludq xmm11, XMMWORD PTR XMM_F1a 
	pmuludq xmm6, XMMWORD PTR XMM_F3a 
	paddq	xmm10, xmm8		
	paddd	xmm9, xmm11		
	movdqa	xmm11, xmm10
	pand	xmm11, xmm15		
	psrlq	xmm10, 30		
	psllq	xmm11, 30		
	paddq	xmm6, xmm11		
	paddd	xmm9, xmm10		

	pxor	xmm5, xmm5		
	movdqa	xmm4, XMMWORD PTR XMM_INITVAL 

	pxor	xmm11, xmm11		
	movdqa	xmm10, XMMWORD PTR XMM_INITVAL 

	psubq	xmm5, xmm0		
	psubd	xmm4, xmm3		

	psubq	xmm11, xmm6		
	psubd	xmm10, xmm9		
	ENDM

sse2_fac MACRO fac_size

	movdqa	xmm2, xmm5
	pand	xmm2, xmm15		
	psrlq	xmm5, 30		
	movdqa	xmm1, xmm5
	pand	xmm1, xmm15		
	psrlq	xmm5, 2			
	psrad	xmm5, 28		
	paddd	xmm4, xmm5		
	movdqa	xmm0, xmm4
	pand	xmm0, XMMWORD PTR XMM_BITS28 

	movdqa	xmm8, xmm11
	pand	xmm8, xmm15		
	psrlq	xmm11, 30		
	movdqa	xmm7, xmm11
	pand	xmm7, xmm15		
	psrlq	xmm11, 2		
	psrad	xmm11, 28		
	paddd	xmm10, xmm11		
	movdqa	xmm6, xmm10
	pand	xmm6, XMMWORD PTR XMM_BITS28 

	movdqa	xmm3, xmm0		
	paddq	xmm3, xmm0		
	movdqa	xmm5, xmm1		
	paddq	xmm5, xmm1		
	pmuludq	xmm1, xmm1		
	movdqa	xmm4, xmm0		
	pmuludq	xmm4, xmm0		
	pmuludq	xmm3, xmm2		
	pmuludq	xmm0, xmm5		
	pmuludq	xmm5, xmm2		
	pmuludq	xmm2, xmm2		
	paddq	xmm1, xmm3		

	movdqa	xmm9, xmm6		
	paddq	xmm9, xmm6		
	movdqa	xmm11, xmm7		
	paddq	xmm11, xmm7		
	pmuludq	xmm7, xmm7		
	movdqa	xmm10, xmm6		
	pmuludq	xmm10, xmm6		
	pmuludq	xmm9, xmm8		
	pmuludq	xmm6, xmm11		
	pmuludq	xmm11, xmm8		
	pmuludq	xmm8, xmm8		
	paddq	xmm7, xmm9		

	IF fac_size GE 75
	movdqa	xmm3, xmm4		
	psrlq	xmm3, 30		
	pmuludq xmm3, XMMWORD PTR XMM_TWO_120_MODF2 
	paddq	xmm1, xmm3		
	movdqa	xmm3, xmm4		
	psrlq	xmm3, 30		
	pmuludq xmm3, XMMWORD PTR XMM_TWO_120_MODF1 
	paddq	xmm0, xmm3		
	movdqa	xmm3, xmm4		
	psrlq	xmm3, 30		
	pmuludq xmm3, XMMWORD PTR XMM_TWO_120_MODF3 
	paddq	xmm5, xmm3		
	pand	xmm4, xmm15		

	movdqa	xmm9, xmm10		
	psrlq	xmm9, 30		
	pmuludq xmm9, XMMWORD PTR XMM_TWO_120_MODF2a 
	paddq	xmm7, xmm9		
	movdqa	xmm9, xmm10		
	psrlq	xmm9, 30		
	pmuludq xmm9, XMMWORD PTR XMM_TWO_120_MODF1a 
	paddq	xmm6, xmm9		
	movdqa	xmm9, xmm10		
	psrlq	xmm9, 30		
	pmuludq xmm9, XMMWORD PTR XMM_TWO_120_MODF3a 
	paddq	xmm11, xmm9		
	pand	xmm10, xmm15		
	ENDIF

	movdqa	xmm3, xmm1		
	psrlq	xmm3, 30		
	pand	xmm1, xmm15		
	paddq	xmm0, xmm3		
	movdqa	xmm3, xmm0		
	psrlq	xmm3, 30		
	pand	xmm0, xmm15		
	psllq	xmm0, 30		
	paddd	xmm4, xmm3		
	por	xmm1, xmm0		
	movdqa	xmm0, xmm4		
	pmuludq xmm0, XMMWORD PTR XMM_TWO_120_MODF2 
	movdqa	xmm3, xmm4		
	pmuludq xmm3, XMMWORD PTR XMM_TWO_120_MODF1 
	pmuludq xmm4, XMMWORD PTR XMM_TWO_120_MODF3 
	paddq	xmm5, xmm0		
	paddq	xmm1, xmm3		
	movdqa	xmm0, xmm5		
	psrlq	xmm0, 30		
	pand	xmm5, xmm15		
	psllq	xmm5, 30		
	paddq	xmm2, xmm4		
	paddq	xmm1, xmm0		
	paddq	xmm2, xmm5		
					
	movdqa	xmm9, xmm7		
	psrlq	xmm9, 30		
	pand	xmm7, xmm15		
	paddq	xmm6, xmm9		
	movdqa	xmm9, xmm6		
	psrlq	xmm9, 30		
	pand	xmm6, xmm15		
	psllq	xmm6, 30		
	paddd	xmm10, xmm9		
	por	xmm7, xmm6		
	movdqa	xmm6, xmm10		
	pmuludq xmm6, XMMWORD PTR XMM_TWO_120_MODF2a 
	movdqa	xmm9, xmm10		
	pmuludq xmm9, XMMWORD PTR XMM_TWO_120_MODF1a 
	pmuludq xmm10, XMMWORD PTR XMM_TWO_120_MODF3a 
	paddq	xmm11, xmm6		
	paddq	xmm7, xmm9		
	movdqa	xmm6, xmm11		
	psrlq	xmm6, 30		
	pand	xmm11, xmm15		
	psllq	xmm11, 30		
	paddq	xmm8, xmm10		
	paddq	xmm7, xmm6		
	paddq	xmm8, xmm11		
					
	movdqa	xmm0, xmm1		
	psrlq	xmm0, 30		
	movdqa	xmm3, xmm1		
	pand	xmm3, xmm15		
	movdqa	xmm4, xmm0		
	pmuludq xmm4, XMMWORD PTR XMM_I2 
	movdqa	xmm5, xmm3		
	pmuludq xmm5, XMMWORD PTR XMM_I1 
	pmuludq xmm0, XMMWORD PTR XMM_I1 
	paddq	xmm4, xmm5		
	psrlq	xmm4, 30		
	paddq	xmm0, xmm4		

	movdqa	xmm6, xmm7		
	psrlq	xmm6, 30		
	movdqa	xmm9, xmm7		
	pand	xmm9, xmm15		
	movdqa	xmm10, xmm6		
	pmuludq xmm10, XMMWORD PTR XMM_I2a 
	movdqa	xmm11, xmm9		
	pmuludq xmm11, XMMWORD PTR XMM_I1a 
	pmuludq xmm6, XMMWORD PTR XMM_I1a 
	paddq	xmm10, xmm11		
	psrlq	xmm10, 30		
	paddq	xmm6, xmm10		

	psrlq	xmm0, XMMWORD PTR XMM_BS 
	movdqa	xmm3, xmm0
	psrlq	xmm3, 30		
	pand	xmm0, xmm15		

	psrlq	xmm6, XMMWORD PTR XMM_BS 
	movdqa	xmm9, xmm6
	psrlq	xmm9, 30		
	pand	xmm6, xmm15		

	movdqa	xmm4, xmm3
	pmuludq xmm4, XMMWORD PTR XMM_F3 
	movdqa	xmm5, xmm0
	pmuludq xmm5, XMMWORD PTR XMM_F2 
	pmuludq xmm3, XMMWORD PTR XMM_F2 
	paddq	xmm4, xmm5		
	movdqa	xmm5, xmm0
	pmuludq xmm5, XMMWORD PTR XMM_F1 
	pmuludq xmm0, XMMWORD PTR XMM_F3 
	paddd	xmm3, xmm5		
	movdqa	xmm5, xmm4
	pand	xmm5, xmm15		
	psrlq	xmm4, 30		
	psllq	xmm5, 30		
	paddq	xmm0, xmm5		
	paddd	xmm3, xmm4		

	movdqa	xmm10, xmm9
	pmuludq xmm10, XMMWORD PTR XMM_F3a 
	movdqa	xmm11, xmm6
	pmuludq xmm11, XMMWORD PTR XMM_F2a 
	pmuludq xmm9, XMMWORD PTR XMM_F2a 
	paddq	xmm10, xmm11		
	movdqa	xmm11, xmm6
	pmuludq xmm11, XMMWORD PTR XMM_F1a 
	pmuludq xmm6, XMMWORD PTR XMM_F3a 
	paddd	xmm9, xmm11		
	movdqa	xmm11, xmm10
	pand	xmm11, xmm15		
	psrlq	xmm10, 30		
	psllq	xmm11, 30		
	paddq	xmm6, xmm11		
	paddd	xmm9, xmm10		

	movdqa	xmm5, xmm2
	psubq	xmm5, xmm0		
	movdqa	xmm4, xmm1
	psubd	xmm4, xmm3		

	movdqa	xmm11, xmm8
	psubq	xmm11, xmm6		
	movdqa	xmm10, xmm7
	psubd	xmm10, xmm9		

	movdqu	xmm0, XMMWORD PTR XMM_SHIFTER[rdi*8]
	psllq	xmm5, xmm0		
	psllq	xmm4, xmm0		

	psllq	xmm11, xmm0		
	psllq	xmm10, xmm0		
	ENDM

sse2_compare_part1 MACRO
	psubq	xmm5, XMMWORD PTR YMM_ONE 
	movdqa	xmm2, xmm5
	pand	xmm2, xmm15		
	psubq	xmm11, XMMWORD PTR YMM_ONE 
	movdqa	xmm8, xmm11
	pand	xmm8, xmm15		
	ENDM

sse2_compare_part2 MACRO
	psrlq	xmm5, 30		
	movdqa	xmm1, xmm5
	pand	xmm1, xmm15		
	psrlq	xmm5, 2			
	psrad	xmm5, 28		
	paddd	xmm4, xmm5		
	movdqa	xmm0, xmm4
	pand	xmm0, XMMWORD PTR XMM_BITS28 
	psrlq	xmm11, 30		
	movdqa	xmm7, xmm11
	pand	xmm7, xmm15		
	psrlq	xmm11, 2		
	psrad	xmm11, 28		
	paddd	xmm10, xmm11		
	movdqa	xmm6, xmm10
	pand	xmm6, XMMWORD PTR XMM_BITS28 
	ENDM

avx2_fac_initval MACRO
	LOCAL	retry, invfac_ok

	vmovdqa	ymm15, YMMWORD PTR YMM_BITS30
	vmovdqa	ymm13, YMMWORD PTR YMM_F2
	vmovdqa	ymm14, YMMWORD PTR YMM_F3

	vmovdqa	ymm1, YMMWORD PTR YMM_INVFAC			
retry:	vpsrlq	ymm3, ymm1, 3					
	vpand	ymm0, ymm3, ymm15				
	vpsrlq	ymm3, ymm3, 30					
	vmovdqa	YMMWORD PTR YMM_I2, ymm0			
	vmovdqa	YMMWORD PTR YMM_I1, ymm3

	vpmuludq ymm4, ymm3, ymm14				
	vpmuludq ymm2, ymm0, ymm13				
	vpmuludq ymm3, ymm3, ymm13				
	vpmuludq ymm5, ymm0, YMMWORD PTR YMM_F1			
	vpmuludq ymm0, ymm0, ymm14				
	vpaddq	ymm4, ymm4, ymm2				
	vpaddd	ymm3, ymm3, ymm5				
	vpand	ymm5, ymm4, ymm15				
	vpsrlq	ymm4, ymm4, 30					
	vpsllq	ymm5, ymm5, 30					
	vpaddq	ymm0, ymm0, ymm5				
	vpaddd	ymm3, ymm3, ymm4				

	vpsrlq	ymm0, ymm0, 60
	vpaddd	ymm3, ymm3, ymm0				

	vpand	ymm3, ymm3, YMMWORD PTR YMM_28TH_BIT		
	vpxor	ymm2, ymm2, ymm2
	vpcmpeqq ymm3, ymm3, ymm2
	vpmovmskb rdx, ymm3
	and	edx, 0FFFFFFFFh					
	jz	short invfac_ok					
	vmovdqa	ymm1, YMMWORD PTR YMM_INVFAC			
	vpaddq	ymm1, ymm1, ymm3				
	vmovdqa	YMMWORD PTR YMM_INVFAC, ymm1			
	jmp	retry						
invfac_ok:

	vmovdqa	ymm1, YMMWORD PTR YMM_INVFAC			
	vpsrlq	ymm3, ymm1, XMMWORD PTR XMM_INIT120BS		
	vpand	ymm0, ymm3, ymm15				
	vpsrlq	ymm3, ymm3, 30					

	vpmuludq ymm4, ymm3, ymm14				
	vpmuludq ymm2, ymm0, ymm13				
	vpmuludq ymm3, ymm3, ymm13				
	vpmuludq ymm5, ymm0, YMMWORD PTR YMM_F1			
	vpmuludq ymm0, ymm0, ymm14				
	vpaddq	ymm4, ymm4, ymm2				
	vpaddd	ymm3, ymm3, ymm5				
	vpand	ymm5, ymm4, ymm15				
	vpsrlq	ymm4, ymm4, 30					
	vpsllq	ymm5, ymm5, 30					
	vpaddq	ymm0, ymm0, ymm5				
	vpaddd	ymm3, ymm3, ymm4				

	vpxor	ymm2, ymm2, ymm2
	vpsubq	ymm5, ymm2, ymm0				
	vpsubd	ymm4, ymm2, ymm3				

	vpand	ymm2, ymm5, ymm15				
	vpsrlq	ymm5, ymm5, 30					
	vpand	ymm1, ymm5, ymm15				
	vpsrlq	ymm5, ymm5, 2					
	vpsrad	ymm5, ymm5, 28					
	vpaddd	ymm4, ymm4, ymm5				
	vpand	ymm0, ymm4, YMMWORD PTR YMM_BITS28		
	vmovdqa YMMWORD PTR YMM_TWO_120_MODF3, ymm2
	vmovdqa YMMWORD PTR YMM_TWO_120_MODF2, ymm1
	vmovdqa YMMWORD PTR YMM_TWO_120_MODF1, ymm0

	vmovdqa	ymm1, YMMWORD PTR YMM_INVFAC			
	vpsrlq	ymm0, ymm1, XMMWORD PTR XMM_INITBS		
	vpsrlq	ymm3, ymm0, 30					
	vpand	ymm0, ymm0, ymm15				

	vpmuludq ymm4, ymm3, ymm14				
	vpmuludq ymm2, ymm0, ymm13				
	vpmuludq ymm3, ymm3, ymm13				
	vpmuludq ymm5, ymm0, YMMWORD PTR YMM_F1			
	vpmuludq ymm0, ymm0, ymm14				
	vpaddq	ymm4, ymm4, ymm2				
	vpaddd	ymm3, ymm3, ymm5				
	vpand	ymm5, ymm4, ymm15				
	vpsrlq	ymm4, ymm4, 30					
	vpsllq	ymm5, ymm5, 30					
	vpaddq	ymm0, ymm0, ymm5				
	vpaddd	ymm3, ymm3, ymm4				

	vpxor	ymm2, ymm2, ymm2				
	vmovdqa	ymm1, YMMWORD PTR YMM_INITVAL			

	vpsubq	ymm5, ymm2, ymm0				
	vpsubd	ymm4, ymm1, ymm3				

	vpand	ymm2, ymm5, ymm15				
	vpsrlq	ymm5, ymm5, 30					
	vpand	ymm1, ymm5, ymm15				
	vpsrlq	ymm5, ymm5, 2					
	vpsrad	ymm5, ymm5, 28					
	vpaddd	ymm4, ymm4, ymm5				
	vpand	ymm0, ymm4, YMMWORD PTR YMM_BITS28		

	vmovdqa	ymm12, YMMWORD PTR YMM_I1
	vmovdqa	ymm9, YMMWORD PTR YMM_TWO_120_MODF1
	vmovdqa	ymm10, YMMWORD PTR YMM_TWO_120_MODF2
	vmovdqa	ymm11, YMMWORD PTR YMM_TWO_120_MODF3
	ENDM

avx2_fac MACRO fac_size

	vpaddq	ymm3, ymm0, ymm0				
	vpaddq	ymm5, ymm1, ymm1				
	vpmuludq ymm1, ymm1, ymm1				
	vpmuludq ymm4, ymm0, ymm0				
	vpmuludq ymm3, ymm3, ymm2				
	vpmuludq ymm0, ymm0, ymm5				
	vpmuludq ymm5, ymm5, ymm2				
	vpmuludq ymm2, ymm2, ymm2				
	vpaddq	ymm1, ymm1, ymm3				
								
	IF fac_size GE 75

	vpsrlq	ymm3, ymm4, 30					

	vpmuludq ymm3, ymm3, ymm10				
	vpaddq	ymm1, ymm1, ymm3				

	vpsrlq	ymm3, ymm4, 30					

	vpmuludq ymm3, ymm3, ymm9				
	vpaddq	ymm0, ymm0, ymm3				

	vpsrlq	ymm3, ymm4, 30					
	vpmuludq ymm3, ymm3, ymm11				
	vpaddq	ymm5, ymm5, ymm3				

	vpand	ymm4, ymm4, ymm15				

	ENDIF

	vpsrlq	ymm3, ymm1, 30					
	vpand	ymm1, ymm1, ymm15				
	vpaddq	ymm0, ymm0, ymm3				
	vpsrlq	ymm3, ymm0, 30					
	vpand	ymm0, ymm0, ymm15				
	vpsllq	ymm0, ymm0, 30					
	vpaddd	ymm4, ymm4, ymm3				
	vpor	ymm1, ymm1, ymm0				
	vpmuludq ymm0, ymm4, ymm10				
	vpmuludq ymm3, ymm4, ymm9				
	vpmuludq ymm4, ymm4, ymm11				
	vpaddq	ymm5, ymm5, ymm0				
	vpaddq	ymm1, ymm1, ymm3				
	vpsrlq	ymm0, ymm5, 30					
	vpand	ymm5, ymm5, ymm15				
	vpsllq	ymm5, ymm5, 30					
	vpaddq	ymm2, ymm2, ymm4				
	vpaddq	ymm1, ymm1, ymm0				
	vpaddq	ymm2, ymm2, ymm5				
								
	vpsrlq	ymm0, ymm1, 30				
	vpand	ymm3, ymm1, ymm15			
	vpmuludq ymm4, ymm0, YMMWORD PTR YMM_I2		
	vpmuludq ymm5, ymm12, ymm3			
	vpmuludq ymm0, ymm12, ymm0			
	vpaddq	ymm4, ymm4, ymm5			
	vpsrlq	ymm4, ymm4, 30				
	vpaddq	ymm0, ymm0, ymm4			

	vpsrlq	ymm0, ymm0, XMMWORD PTR XMM_BS		
	vpsrlq	ymm3, ymm0, 30				
	vpand	ymm0, ymm0, ymm15			

	vpmuludq ymm4, ymm3, ymm14			
	vpmuludq ymm5, ymm0, ymm13			
	vpmuludq ymm3, ymm3, ymm13			

	vpaddq	ymm4, ymm4, ymm5			
	vpmuludq ymm5, ymm0, YMMWORD PTR YMM_F1		
	vpmuludq ymm0, ymm0, ymm14			
	vpaddd	ymm3, ymm3, ymm5			

	vpand	ymm5, ymm4, ymm15			
	vpsrlq	ymm4, ymm4, 30				
	vpsllq	ymm5, ymm5, 30				
	vpaddq	ymm0, ymm0, ymm5			
	vpaddd	ymm3, ymm3, ymm4			

	vpsubq	ymm5, ymm2, ymm0			
	vpsubd	ymm4, ymm1, ymm3			

	vmovdqu	xmm0, XMMWORD PTR XMM_SHIFTER[rdi*8]
	vpsllq	ymm5, ymm5, xmm0			
	vpsllq	ymm4, ymm4, xmm0			

	vpand	ymm2, ymm5, ymm15			
	vpsrlq	ymm5, ymm5, 30				
	vpand	ymm1, ymm5, ymm15			
	vpsrlq	ymm5, ymm5, 2				
	vpsrad	ymm5, ymm5, 28				
	vpaddd	ymm4, ymm4, ymm5			
	vpand	ymm0, ymm4, YMMWORD PTR YMM_BITS28	
	ENDM

avx2_fac_initval MACRO
	LOCAL	retry, invfac_adjust, invfac_ok

	vmovdqa	ymm15, YMMWORD PTR YMM_BITS30

	vmovdqa	ymm1, YMMWORD PTR YMM_INVFAC			
	vmovdqa	ymm7, YMMWORD PTR YMM_INVFACa			
retry:	vpsrlq	ymm3, ymm1, 3					
	vpand	ymm0, ymm3, ymm15				
	vpsrlq	ymm3, ymm3, 30					
	vmovdqa	YMMWORD PTR YMM_I2, ymm0			
	vmovdqa	YMMWORD PTR YMM_I1, ymm3

	vpsrlq	ymm9, ymm7, 3					
	vpand	ymm6, ymm9, ymm15				
	vpsrlq	ymm9, ymm9, 30					
	vmovdqa	YMMWORD PTR YMM_I2a, ymm6			
	vmovdqa	YMMWORD PTR YMM_I1a, ymm9

	vpmuludq ymm4, ymm3, YMMWORD PTR YMM_F3			
	vpmuludq ymm2, ymm0, YMMWORD PTR YMM_F2			
	vpmuludq ymm3, ymm3, YMMWORD PTR YMM_F2			
	vpmuludq ymm5, ymm0, YMMWORD PTR YMM_F1			
	vpmuludq ymm0, ymm0, YMMWORD PTR YMM_F3			
	vpaddq	ymm4, ymm4, ymm2				
	vpaddd	ymm3, ymm3, ymm5				
	vpand	ymm5, ymm4, ymm15				
	vpsrlq	ymm4, ymm4, 30					
	vpsllq	ymm5, ymm5, 30					
	vpaddq	ymm0, ymm0, ymm5				
	vpaddd	ymm3, ymm3, ymm4				

	vpmuludq ymm10, ymm9, YMMWORD PTR YMM_F3a		
	vpmuludq ymm8, ymm6, YMMWORD PTR YMM_F2a		
	vpmuludq ymm9, ymm9, YMMWORD PTR YMM_F2a		
	vpmuludq ymm11, ymm6, YMMWORD PTR YMM_F1a		
	vpmuludq ymm6, ymm6, YMMWORD PTR YMM_F3a		
	vpaddq	ymm10, ymm10, ymm8				
	vpaddd	ymm9, ymm9, ymm11				
	vpand	ymm11, ymm10, ymm15				
	vpsrlq	ymm10, ymm10, 30				
	vpsllq	ymm11, ymm11, 30				
	vpaddq	ymm6, ymm6, ymm11				
	vpaddd	ymm9, ymm9, ymm10				

	vpsrlq	ymm0, ymm0, 60
	vpaddd	ymm3, ymm3, ymm0				

	vpsrlq	ymm6, ymm6, 60
	vpaddd	ymm9, ymm9, ymm6				

	vpand	ymm3, ymm3, YMMWORD PTR YMM_28TH_BIT		
	vpxor	ymm2, ymm2, ymm2
	vpcmpeqq ymm3, ymm3, ymm2
	vpand	ymm9, ymm9, YMMWORD PTR YMM_28TH_BIT		
	vpcmpeqq ymm9, ymm9, ymm2
	vpmovmskb rdx, ymm3
	and	edx, 0FFFFFFFFh					
	jnz	short invfac_adjust				
	vpmovmskb rdx, ymm9
	and	edx, 0FFFFFFFFh					
	jz	short invfac_ok					
invfac_adjust:
	vmovdqa	ymm1, YMMWORD PTR YMM_INVFAC			
	vpaddq	ymm1, ymm1, ymm3				
	vmovdqa	YMMWORD PTR YMM_INVFAC, ymm1			
	vmovdqa	ymm7, YMMWORD PTR YMM_INVFACa			
	vpaddq	ymm7, ymm7, ymm9				
	vmovdqa	YMMWORD PTR YMM_INVFACa, ymm7			
	jmp	retry						
invfac_ok:

	vmovdqa	ymm1, YMMWORD PTR YMM_INVFAC			
	vpsrlq	ymm3, ymm1, XMMWORD PTR XMM_INIT120BS		
	vpand	ymm0, ymm3, ymm15				
	vpsrlq	ymm3, ymm3, 30					

	vmovdqa	ymm7, YMMWORD PTR YMM_INVFACa			
	vpsrlq	ymm9, ymm7, XMMWORD PTR XMM_INIT120BS		
	vpand	ymm6, ymm9, ymm15				
	vpsrlq	ymm9, ymm9, 30					

	vpmuludq ymm4, ymm3, YMMWORD PTR YMM_F3			
	vpmuludq ymm2, ymm0, YMMWORD PTR YMM_F2			
	vpmuludq ymm3, ymm3, YMMWORD PTR YMM_F2			
	vpmuludq ymm5, ymm0, YMMWORD PTR YMM_F1			
	vpmuludq ymm0, ymm0, YMMWORD PTR YMM_F3			
	vpaddq	ymm4, ymm4, ymm2				
	vpaddd	ymm3, ymm3, ymm5				
	vpand	ymm5, ymm4, ymm15				
	vpsrlq	ymm4, ymm4, 30					
	vpsllq	ymm5, ymm5, 30					
	vpaddq	ymm0, ymm0, ymm5				
	vpaddd	ymm3, ymm3, ymm4				

	vpmuludq ymm10, ymm9, YMMWORD PTR YMM_F3a		
	vpmuludq ymm8, ymm6, YMMWORD PTR YMM_F2a		
	vpmuludq ymm9, ymm9, YMMWORD PTR YMM_F2a		
	vpmuludq ymm11, ymm6, YMMWORD PTR YMM_F1a		
	vpmuludq ymm6, ymm6, YMMWORD PTR YMM_F3a		
	vpaddq	ymm10, ymm10, ymm8				
	vpaddd	ymm9, ymm9, ymm11				
	vpand	ymm11, ymm10, ymm15				
	vpsrlq	ymm10, ymm10, 30				
	vpsllq	ymm11, ymm11, 30				
	vpaddq	ymm6, ymm6, ymm11				
	vpaddd	ymm9, ymm9, ymm10				

	vpxor	ymm2, ymm2, ymm2
	vpsubq	ymm5, ymm2, ymm0				
	vpsubd	ymm4, ymm2, ymm3				

	vpsubq	ymm11, ymm2, ymm6				
	vpsubd	ymm10, ymm2, ymm9				

	vpand	ymm2, ymm5, ymm15				
	vpsrlq	ymm5, ymm5, 30					
	vpand	ymm1, ymm5, ymm15				
	vpsrlq	ymm5, ymm5, 2					
	vpsrad	ymm5, ymm5, 28					
	vpaddd	ymm4, ymm4, ymm5				
	vpand	ymm0, ymm4, YMMWORD PTR YMM_BITS28		
	vmovdqa YMMWORD PTR YMM_TWO_120_MODF3, ymm2
	vmovdqa YMMWORD PTR YMM_TWO_120_MODF2, ymm1
	vmovdqa YMMWORD PTR YMM_TWO_120_MODF1, ymm0

	vpand	ymm8, ymm11, ymm15				
	vpsrlq	ymm11, ymm11, 30				
	vpand	ymm7, ymm11, ymm15				
	vpsrlq	ymm11, ymm11, 2					
	vpsrad	ymm11, ymm11, 28				
	vpaddd	ymm10, ymm10, ymm11				
	vpand	ymm6, ymm10, YMMWORD PTR YMM_BITS28		
	vmovdqa YMMWORD PTR YMM_TWO_120_MODF3a, ymm8
	vmovdqa YMMWORD PTR YMM_TWO_120_MODF2a, ymm7
	vmovdqa YMMWORD PTR YMM_TWO_120_MODF1a, ymm6

	vmovdqa	ymm1, YMMWORD PTR YMM_INVFAC			
	vpsrlq	ymm0, ymm1, XMMWORD PTR XMM_INITBS		
	vpsrlq	ymm3, ymm0, 30					
	vpand	ymm0, ymm0, ymm15				

	vmovdqa	ymm7, YMMWORD PTR YMM_INVFACa			
	vpsrlq	ymm6, ymm7, XMMWORD PTR XMM_INITBS		
	vpsrlq	ymm9, ymm6, 30					
	vpand	ymm6, ymm6, ymm15				

	vpmuludq ymm4, ymm3, YMMWORD PTR YMM_F3			
	vpmuludq ymm2, ymm0, YMMWORD PTR YMM_F2			
	vpmuludq ymm3, ymm3, YMMWORD PTR YMM_F2			
	vpmuludq ymm5, ymm0, YMMWORD PTR YMM_F1			
	vpmuludq ymm0, ymm0, YMMWORD PTR YMM_F3			
	vpaddq	ymm4, ymm4, ymm2				
	vpaddd	ymm3, ymm3, ymm5				
	vpand	ymm5, ymm4, ymm15				
	vpsrlq	ymm4, ymm4, 30					
	vpsllq	ymm5, ymm5, 30					
	vpaddq	ymm0, ymm0, ymm5				
	vpaddd	ymm3, ymm3, ymm4				

	vpmuludq ymm10, ymm9, YMMWORD PTR YMM_F3a		
	vpmuludq ymm8, ymm6, YMMWORD PTR YMM_F2a		
	vpmuludq ymm9, ymm9, YMMWORD PTR YMM_F2a		
	vpmuludq ymm11, ymm6, YMMWORD PTR YMM_F1a		
	vpmuludq ymm6, ymm6, YMMWORD PTR YMM_F3a		
	vpaddq	ymm10, ymm10, ymm8				
	vpaddd	ymm9, ymm9, ymm11				
	vpand	ymm11, ymm10, ymm15				
	vpsrlq	ymm10, ymm10, 30				
	vpsllq	ymm11, ymm11, 30				
	vpaddq	ymm6, ymm6, ymm11				
	vpaddd	ymm9, ymm9, ymm10				

	vpxor	ymm2, ymm2, ymm2				
	vmovdqa	ymm1, YMMWORD PTR YMM_INITVAL			

	vpsubq	ymm5, ymm2, ymm0				
	vpsubd	ymm4, ymm1, ymm3				

	vpsubq	ymm11, ymm2, ymm6				
	vpsubd	ymm10, ymm1, ymm9				
	ENDM

avx2_fac MACRO fac_size

	vpand	ymm2, ymm5, ymm15				
	vpsrlq	ymm5, ymm5, 30					
	vpand	ymm1, ymm5, ymm15				
	vpsrlq	ymm5, ymm5, 2					
	vpsrad	ymm5, ymm5, 28					
	vpaddd	ymm4, ymm4, ymm5				
	vpand	ymm0, ymm4, YMMWORD PTR YMM_BITS28		

	vpand	ymm8, ymm11, ymm15				
	vpsrlq	ymm11, ymm11, 30				
	vpand	ymm7, ymm11, ymm15				
	vpsrlq	ymm11, ymm11, 2					
	vpsrad	ymm11, ymm11, 28				
	vpaddd	ymm10, ymm10, ymm11				
	vpand	ymm6, ymm10, YMMWORD PTR YMM_BITS28		

	vpaddq	ymm3, ymm0, ymm0				
	vpaddq	ymm5, ymm1, ymm1				
	vpmuludq ymm1, ymm1, ymm1				
	vpmuludq ymm4, ymm0, ymm0				
	vpmuludq ymm3, ymm3, ymm2				
	vpmuludq ymm0, ymm0, ymm5				
	vpmuludq ymm5, ymm5, ymm2				
	vpmuludq ymm2, ymm2, ymm2				
	vpaddq	ymm1, ymm1, ymm3				
								
	vpaddq	ymm9, ymm6, ymm6				
	vpaddq	ymm11, ymm7, ymm7				
	vpmuludq ymm7, ymm7, ymm7				
	vpmuludq ymm10, ymm6, ymm6				
	vpmuludq ymm9, ymm9, ymm8				
	vpmuludq ymm6, ymm6, ymm11				
	vpmuludq ymm11, ymm11, ymm8				
	vpmuludq ymm8, ymm8, ymm8				
	vpaddq	ymm7, ymm7, ymm9				
								
	IF fac_size GE 75
	vpsrlq	ymm3, ymm4, 30					
	vpmuludq ymm12, ymm3, YMMWORD PTR YMM_TWO_120_MODF2	
	vpaddq	ymm1, ymm1, ymm12				
	vpmuludq ymm12, ymm3, YMMWORD PTR YMM_TWO_120_MODF1	
	vpaddq	ymm0, ymm0, ymm12				
	vpmuludq ymm3, ymm3, YMMWORD PTR YMM_TWO_120_MODF3	
	vpaddq	ymm5, ymm5, ymm3				
	vpand	ymm4, ymm4, ymm15				

	vpsrlq	ymm9, ymm10, 30					
	vpmuludq ymm12, ymm9, YMMWORD PTR YMM_TWO_120_MODF2a	
	vpaddq	ymm7, ymm7, ymm12				
	vpmuludq ymm12, ymm9, YMMWORD PTR YMM_TWO_120_MODF1a	
	vpaddq	ymm6, ymm6, ymm12				
	vpmuludq ymm9, ymm9, YMMWORD PTR YMM_TWO_120_MODF3a	
	vpaddq	ymm11, ymm11, ymm9				
	vpand	ymm10, ymm10, ymm15				
	ENDIF

	vpsrlq	ymm3, ymm1, 30					
	vpand	ymm1, ymm1, ymm15				
	vpaddq	ymm0, ymm0, ymm3				
	vpsrlq	ymm3, ymm0, 30					
	vpand	ymm0, ymm0, ymm15				
	vpsllq	ymm0, ymm0, 30					
	vpaddd	ymm4, ymm4, ymm3				
	vpor	ymm1, ymm1, ymm0				
	vpmuludq ymm0, ymm4, YMMWORD PTR YMM_TWO_120_MODF2	
	vpmuludq ymm3, ymm4, YMMWORD PTR YMM_TWO_120_MODF1	
	vpmuludq ymm4, ymm4, YMMWORD PTR YMM_TWO_120_MODF3	
	vpaddq	ymm5, ymm5, ymm0				
	vpaddq	ymm1, ymm1, ymm3				
	vpsrlq	ymm0, ymm5, 30					
	vpand	ymm5, ymm5, ymm15				
	vpsllq	ymm5, ymm5, 30					
	vpaddq	ymm2, ymm2, ymm4				
	vpaddq	ymm1, ymm1, ymm0				
	vpaddq	ymm2, ymm2, ymm5				
								
	vpsrlq	ymm9, ymm7, 30					
	vpand	ymm7, ymm7, ymm15				
	vpaddq	ymm6, ymm6, ymm9				
	vpsrlq	ymm9, ymm6, 30					
	vpand	ymm6, ymm6, ymm15				
	vpsllq	ymm6, ymm6, 30					
	vpaddd	ymm10, ymm10, ymm9				
	vpor	ymm7, ymm7, ymm6				
	vpmuludq ymm6, ymm10, YMMWORD PTR YMM_TWO_120_MODF2a	
	vpmuludq ymm9, ymm10, YMMWORD PTR YMM_TWO_120_MODF1a	
	vpmuludq ymm10, ymm10, YMMWORD PTR YMM_TWO_120_MODF3a	
	vpaddq	ymm11, ymm11, ymm6				
	vpaddq	ymm7, ymm7, ymm9				
	vpsrlq	ymm6, ymm11, 30					
	vpand	ymm11, ymm11, ymm15				
	vpsllq	ymm11, ymm11, 30				
	vpaddq	ymm8, ymm8, ymm10				
	vpaddq	ymm7, ymm7, ymm6				
	vpaddq	ymm8, ymm8, ymm11				
								
	vpsrlq	ymm0, ymm1, 30				
	vpand	ymm3, ymm1, ymm15			
	vpmuludq ymm4, ymm0, YMMWORD PTR YMM_I2		
	vpmuludq ymm5, ymm3, YMMWORD PTR YMM_I1		
	vpmuludq ymm0, ymm0, YMMWORD PTR YMM_I1		
	vpaddq	ymm4, ymm4, ymm5			
	vpsrlq	ymm4, ymm4, 30				
	vpaddq	ymm0, ymm0, ymm4			

	vpsrlq	ymm6, ymm7, 30				
	vpand	ymm9, ymm7, ymm15			
	vpmuludq ymm10, ymm6, YMMWORD PTR YMM_I2a	
	vpmuludq ymm11, ymm9, YMMWORD PTR YMM_I1a	
	vpmuludq ymm6, ymm6, YMMWORD PTR YMM_I1a	
	vpaddq	ymm10, ymm10, ymm11			
	vpsrlq	ymm10, ymm10, 30			
	vpaddq	ymm6, ymm6, ymm10			

	vpsrlq	ymm0, ymm0, XMMWORD PTR XMM_BS		
	vpsrlq	ymm3, ymm0, 30				
	vpand	ymm0, ymm0, ymm15			

	vpsrlq	ymm6, ymm6, XMMWORD PTR XMM_BS		
	vpsrlq	ymm9, ymm6, 30				
	vpand	ymm6, ymm6, ymm15			

	vpmuludq ymm4, ymm3, YMMWORD PTR YMM_F3		
	vpmuludq ymm5, ymm0, YMMWORD PTR YMM_F2		
	vpmuludq ymm3, ymm3, YMMWORD PTR YMM_F2		

	vpaddq	ymm4, ymm4, ymm5			
	vpmuludq ymm5, ymm0, YMMWORD PTR YMM_F1		
	vpmuludq ymm0, ymm0, YMMWORD PTR YMM_F3		
	vpaddd	ymm3, ymm3, ymm5			

	vpand	ymm5, ymm4, ymm15			
	vpsrlq	ymm4, ymm4, 30				
	vpsllq	ymm5, ymm5, 30				
	vpaddq	ymm0, ymm0, ymm5			
	vpaddd	ymm3, ymm3, ymm4			

	vpmuludq ymm10, ymm9, YMMWORD PTR YMM_F3a	
	vpmuludq ymm11, ymm6, YMMWORD PTR YMM_F2a	
	vpmuludq ymm9, ymm9, YMMWORD PTR YMM_F2a	

	vpaddq	ymm10, ymm10, ymm11			
	vpmuludq ymm11, ymm6, YMMWORD PTR YMM_F1a	
	vpmuludq ymm6, ymm6, YMMWORD PTR YMM_F3a	
	vpaddd	ymm9, ymm9, ymm11			

	vpand	ymm11, ymm10, ymm15			
	vpsrlq	ymm10, ymm10, 30			
	vpsllq	ymm11, ymm11, 30			
	vpaddq	ymm6, ymm6, ymm11			
	vpaddd	ymm9, ymm9, ymm10			

	vpsubq	ymm5, ymm2, ymm0			
	vpsubd	ymm4, ymm1, ymm3			

	vpsubq	ymm11, ymm8, ymm6			
	vpsubd	ymm10, ymm7, ymm9			

	vmovdqu	xmm0, XMMWORD PTR XMM_SHIFTER[rdi*8]
	vpsllq	ymm5, ymm5, xmm0			
	vpsllq	ymm4, ymm4, xmm0			

	vpsllq	ymm11, ymm11, xmm0			
	vpsllq	ymm10, ymm10, xmm0			
	ENDM

avx2_compare_part1 MACRO
	vpsubq	ymm5, ymm5, YMMWORD PTR YMM_ONE		
	vpand	ymm2, ymm5, ymm15			
	vpsubq	ymm11, ymm11, YMMWORD PTR YMM_ONE	
	vpand	ymm8, ymm11, ymm15			
	ENDM

avx2_compare_part2 MACRO
	vpsrlq	ymm5, ymm5, 30				
	vpand	ymm1, ymm5, ymm15			
	vpsrlq	ymm5, ymm5, 2				
	vpsrad	ymm5, ymm5, 28				
	vpaddd	ymm4, ymm4, ymm5			
	vpand	ymm0, ymm4, YMMWORD PTR YMM_BITS28	
	vpsrlq	ymm11, ymm11, 30			
	vpand	ymm7, ymm11, ymm15			
	vpsrlq	ymm11, ymm11, 2				
	vpsrad	ymm11, ymm11, 28			
	vpaddd	ymm10, ymm10, ymm11			
	vpand	ymm6, ymm10, YMMWORD PTR YMM_BITS28	
	ENDM

avx_fma_fac_initval MACRO
	LOCAL	large_initial_value, small_initial_value, equals_split, done

	vmovapd	ymm15, YMMWORD PTR YMM_FMA_RND_CONST3		
	vmovapd	ymm14, YMMWORD PTR YMM_FMA_RND_CONST2		
	lea	r8, YMM_FMA_ONE_OR_TWO				

	vmovapd	ymm13, YMMWORD PTR YMM_FMA_LOW_MASK		
	vandpd	ymm0, ymm13, YMMWORD PTR YMM_FMA_FAC_LO_INT	
	vorpd	ymm0, ymm0, ymm15				
	vorpd	ymm1, ymm15, YMMWORD PTR YMM_FMA_FAC_HI_INT	
	yfmsubpd ymm1, ymm1, YMMWORD PTR YMM_FMA_TWO_TO_LO, ymm14 
	vsubpd	ymm0, ymm0, ymm15				
	vmovapd	YMMWORD PTR YMM_FMA_FAC_HI, ymm0		
	vmovapd	YMMWORD PTR YMM_FMA_FAC_LO, ymm1		

	vaddpd	ymm3, ymm0, ymm1				
	vmovapd	ymm2, YMMWORD PTR YMM_FMA_ONE
	vdivpd	ymm2, ymm2, ymm3				
	vmovapd	YMMWORD PTR YMM_FMA_INVFAC, ymm2		

	vmovapd	ymm13, YMMWORD PTR YMM_FMA_RND_CONST4		
	vaddpd	ymm4, ymm2, ymm13				
	vsubpd	ymm4, ymm4, ymm13				
	yfnmaddpd ymm5, ymm4, ymm0, YMMWORD PTR YMM_FMA_ONE	
	vmovapd	ymm12, YMMWORD PTR YMM_FMA_RND_CONST5		
	yfnmaddpd ymm6, ymm4, ymm1, ymm12			
	vsubpd	ymm6, ymm6, ymm12				
	yfnmsubpd ymm4, ymm4, ymm1, ymm6			
	vaddpd	ymm5, ymm5, ymm6				
	vmovapd	YMMWORD PTR YMM_FMA_TWOPOW1_MODF_HI, ymm5	
	vmovapd	YMMWORD PTR YMM_FMA_TWOPOW1_MODF_LO, ymm4	

	vmovapd	ymm5, YMMWORD PTR YMM_FMA_TWO			
	yfmaddpd ymm4, ymm5, ymm2, ymm13			
	vsubpd	ymm4, ymm4, ymm13				
	yfnmaddpd ymm3, ymm4, ymm0, ymm5			
	yfnmaddpd ymm6, ymm4, ymm1, ymm12			
	vsubpd	ymm6, ymm6, ymm12				
	yfnmsubpd ymm4, ymm4, ymm1, ymm6			
	vaddpd	ymm3, ymm3, ymm6				
	vmovapd	YMMWORD PTR YMM_FMA_TWOPOW2_MODF_HI, ymm3	
	vmovapd	YMMWORD PTR YMM_FMA_TWOPOW2_MODF_LO, ymm4	

	cmp	FMA_INITVAL_TYPE, 0
	jl	small_initial_value
	je	short large_initial_value

	vmovapd	ymm13, YMMWORD PTR YMM_FMA_TWOPOW_SPLIT		
	cmp	FMA_INITVAL_TYPE, 1
	je	short equals_split
	vmulpd	ymm3, ymm13, ymm3
	vmulpd	ymm4, ymm13, ymm4
	jmp	done

equals_split:
	vmulpd	ymm3, ymm13, YMMWORD PTR YMM_FMA_TWOPOW1_MODF_HI
	vmulpd	ymm4, ymm13, YMMWORD PTR YMM_FMA_TWOPOW1_MODF_LO
	jmp	done

large_initial_value:

	vmovapd	ymm5, YMMWORD PTR YMM_FMA_INITVAL		
	vmovapd	ymm13, YMMWORD PTR YMM_FMA_RND_CONST1		
	yfmaddpd ymm6, ymm5, ymm3, ymm13			
	vsubpd	ymm6, ymm6, ymm13				
	yfmsubpd ymm3, ymm5, ymm3, ymm6				
								
	yfmaddpd ymm7, ymm5, ymm4, ymm14			
	vsubpd	ymm7, ymm7, ymm14				
	yfmsubpd ymm4, ymm5, ymm4, ymm7				
	vaddpd	ymm3, ymm3, ymm7				
								
	yfmaddpd ymm2, ymm6, ymm2, ymm15			
	vsubpd	ymm2, ymm2, ymm15				

	yfnmaddpd ymm0, ymm2, ymm0, ymm6			
	vaddpd	ymm3, ymm3, ymm0				

	yfnmaddpd ymm0, ymm2, ymm1, ymm14			
	vsubpd	ymm0, ymm0, ymm14				
	yfnmsubpd ymm1, ymm2, ymm1, ymm0			

	vaddpd	ymm3, ymm3, ymm0				
	vaddpd	ymm4, ymm4, ymm1				

	jmp	done

small_initial_value:
	vmovapd	ymm3, YMMWORD PTR YMM_FMA_INITVAL		

	yfmaddpd ymm2, ymm3, ymm2, ymm15			
	vsubpd	ymm2, ymm2, ymm15				
	yfnmaddpd ymm3, ymm2, ymm0, ymm3			

	yfnmaddpd ymm0, ymm2, ymm1, ymm14			
	vsubpd	ymm0, ymm0, ymm14				
	yfnmsubpd ymm4, ymm2, ymm1, ymm0			

	vaddpd	ymm3, ymm3, ymm0				

done:
	ENDM

avx_fma_fac MACRO fac_size

	vmovapd	ymm15, YMMWORD PTR YMM_FMA_RND_CONST0		
	yfmaddpd ymm0, ymm3, ymm3, ymm15			
	vsubpd	ymm0, ymm0, ymm15				
	yfmsubpd ymm1, ymm3, ymm3, ymm0				

	vmovapd	ymm15, YMMWORD PTR YMM_FMA_RND_CONST1		
	yfmaddpd ymm2, ymm3, ymm4, ymm15			
	vsubpd	ymm2, ymm2, ymm15				
	yfmsubpd ymm3, ymm3, ymm4, ymm2				

	yfmaddpd ymm2, YMMWORD PTR YMM_FMA_TWO, ymm2, ymm1	

	vmovapd	ymm15, YMMWORD PTR YMM_FMA_RND_CONST2		
	yfmaddpd ymm1, ymm4, ymm4, ymm15			
	vsubpd	ymm1, ymm1, ymm15				
	yfmsubpd ymm4, ymm4, ymm4, ymm1				

	yfmaddpd ymm3, YMMWORD PTR YMM_FMA_TWO, ymm3, ymm1	

	mov	edx, FMA_SHIFTER[rdi*4-4]			

	vmovapd	ymm15, YMMWORD PTR YMM_FMA_RND_CONST1		
	yfmaddpd ymm5, ymm0, YMMWORD PTR YMM_FMA_TWOPOW1_MODF_HI[rdx], ymm15 
	vsubpd	ymm5, ymm5, ymm15				
	yfmsubpd ymm1, ymm0, YMMWORD PTR YMM_FMA_TWOPOW1_MODF_HI[rdx], ymm5 

	yfmaddpd ymm2, YMMWORD PTR [r8][rdx], ymm2, ymm5	

	yfmaddpd ymm3, YMMWORD PTR [r8][rdx], ymm3, ymm1	

	vmovapd	ymm15, YMMWORD PTR YMM_FMA_RND_CONST2		
	yfmaddpd ymm1, ymm0, YMMWORD PTR YMM_FMA_TWOPOW1_MODF_LO[rdx], ymm15 
	vsubpd	ymm1, ymm1, ymm15				
	yfmsubpd ymm0, ymm0, YMMWORD PTR YMM_FMA_TWOPOW1_MODF_LO[rdx], ymm1 

	vaddpd	ymm3, ymm3, ymm1				

	yfmaddpd ymm4, YMMWORD PTR [r8][rdx], ymm4, ymm0	

	vmovapd	ymm15, YMMWORD PTR YMM_FMA_RND_CONST3		
	yfmaddpd ymm1, ymm2, YMMWORD PTR YMM_FMA_INVFAC, ymm15	
	vsubpd	ymm1, ymm1, ymm15				

	yfnmaddpd ymm2, ymm1, YMMWORD PTR YMM_FMA_FAC_HI, ymm2	
	vaddpd	ymm3, ymm3, ymm2				

	vmovapd	ymm15, YMMWORD PTR YMM_FMA_RND_CONST2		
	yfnmaddpd ymm0, ymm1, YMMWORD PTR YMM_FMA_FAC_LO, ymm15	
	vsubpd	ymm0, ymm0, ymm15				
	yfnmsubpd ymm1, ymm1, YMMWORD PTR YMM_FMA_FAC_LO, ymm0	

	vaddpd	ymm3, ymm3, ymm0				
	vaddpd	ymm4, ymm4, ymm1				
	ENDM

avx_fma_compare MACRO
	vaddpd	ymm2, ymm3, ymm4				
	ENDM

avx_fma_fac_initval MACRO avx_level
	LOCAL	large_initial_value, small_initial_value, equals_split, done

	vmovapd	ymm15, YMMWORD PTR YMM_FMA_RND_CONST3		
	vmovapd	ymm14, YMMWORD PTR YMM_FMA_RND_CONST2		
	lea	r8, YMM_FMA_ONE_OR_TWO				

	vmovapd	ymm13, YMMWORD PTR YMM_FMA_LOW_MASK		
	vandpd	ymm0, ymm13, YMMWORD PTR YMM_FMA_FAC_LO_INT	
	vandpd	ymm4, ymm13, YMMWORD PTR YMM_FMA_FAC_LO_INTa	

	vorpd	ymm0, ymm0, ymm15				
	vorpd	ymm4, ymm4, ymm15				

	vorpd	ymm10, ymm15, YMMWORD PTR YMM_FMA_FAC_HI_INT	
	vorpd	ymm11, ymm15, YMMWORD PTR YMM_FMA_FAC_HI_INTa	

	vmovapd	ymm13, YMMWORD PTR YMM_FMA_TWO_TO_LO		
	yfmsubpd ymm10, ymm10, ymm13, ymm14			
	yfmsubpd ymm11, ymm11, ymm13, ymm14			

	vsubpd	ymm0, ymm0, ymm15				
	vsubpd	ymm4, ymm4, ymm15				

	vmovapd	YMMWORD PTR YMM_FMA_FAC_HI, ymm10		
	vmovapd	YMMWORD PTR YMM_FMA_FAC_HIa, ymm11		

	vmovapd	YMMWORD PTR YMM_FMA_FAC_LO, ymm0		
	vmovapd	YMMWORD PTR YMM_FMA_FAC_LOa, ymm4		

	vaddpd	ymm3, ymm10, ymm0				
	vaddpd	ymm7, ymm11, ymm4				
	vmovapd	ymm9, YMMWORD PTR YMM_FMA_ONE
	vdivpd	ymm8, ymm9, ymm3				
	vdivpd	ymm9, ymm9, ymm7				
	vmovapd	YMMWORD PTR YMM_FMA_INVFAC, ymm8		
	vmovapd	YMMWORD PTR YMM_FMA_INVFACa, ymm9		

	vmovapd	ymm13, YMMWORD PTR YMM_FMA_RND_CONST4		
	vaddpd	ymm1, ymm8, ymm13				
	vaddpd	ymm5, ymm9, ymm13				
	vsubpd	ymm1, ymm1, ymm13				
	vsubpd	ymm5, ymm5, ymm13				
	vmovapd	ymm12, YMMWORD PTR YMM_FMA_ONE			
	yfnmaddpd ymm2, ymm1, ymm10, ymm12			
	yfnmaddpd ymm6, ymm5, ymm11, ymm12			
	vmovapd	ymm12, YMMWORD PTR YMM_FMA_RND_CONST5		
	yfnmaddpd ymm3, ymm1, ymm0, ymm12			
	yfnmaddpd ymm7, ymm5, ymm4, ymm12			
	vsubpd	ymm3, ymm3, ymm12				
	vsubpd	ymm7, ymm7, ymm12				
	vaddpd	ymm2, ymm2, ymm3				
	vaddpd	ymm6, ymm6, ymm7				
	yfnmsubpd ymm1, ymm1, ymm0, ymm3			
	yfnmsubpd ymm5, ymm5, ymm4, ymm7			
	vmovapd	YMMWORD PTR YMM_FMA_TWOPOW1_MODF_HI, ymm2	
	vmovapd	YMMWORD PTR YMM_FMA_TWOPOW1_MODF_HIa, ymm6	
	vmovapd	YMMWORD PTR YMM_FMA_TWOPOW1_MODF_LO, ymm1	
	vmovapd	YMMWORD PTR YMM_FMA_TWOPOW1_MODF_LOa, ymm5	

	vmovapd	ymm12, YMMWORD PTR YMM_FMA_TWO			
	yfmaddpd ymm1, ymm12, ymm8, ymm13			
	yfmaddpd ymm5, ymm12, ymm9, ymm13			
	vsubpd	ymm1, ymm1, ymm13				
	vsubpd	ymm5, ymm5, ymm13				
	yfnmaddpd ymm2, ymm1, ymm10, ymm12			
	yfnmaddpd ymm6, ymm5, ymm11, ymm12			
	vmovapd	ymm12, YMMWORD PTR YMM_FMA_RND_CONST5		
	yfnmaddpd ymm3, ymm1, ymm0, ymm12			
	yfnmaddpd ymm7, ymm5, ymm4, ymm12			
	vsubpd	ymm3, ymm3, ymm12				
	vsubpd	ymm7, ymm7, ymm12				
	vaddpd	ymm2, ymm2, ymm3				
	vaddpd	ymm6, ymm6, ymm7				
	yfnmsubpd ymm1, ymm1, ymm0, ymm3			
	yfnmsubpd ymm5, ymm5, ymm4, ymm7			
	vmovapd	YMMWORD PTR YMM_FMA_TWOPOW2_MODF_HI, ymm2	
	vmovapd	YMMWORD PTR YMM_FMA_TWOPOW2_MODF_HIa, ymm6	
	vmovapd	YMMWORD PTR YMM_FMA_TWOPOW2_MODF_LO, ymm1	
	vmovapd	YMMWORD PTR YMM_FMA_TWOPOW2_MODF_LOa, ymm5	

	cmp	FMA_INITVAL_TYPE, 0
	jl	small_initial_value
	je	short large_initial_value

	vmovapd	ymm13, YMMWORD PTR YMM_FMA_TWOPOW_SPLIT		
	cmp	FMA_INITVAL_TYPE, 1
	je	short equals_split
	vmulpd	ymm2, ymm13, ymm2				
	vmulpd	ymm3, ymm13, ymm1
	vmulpd	ymm6, ymm13, ymm6				
	vmulpd	ymm7, ymm13, ymm5
	jmp	done

equals_split:
	vmulpd	ymm2, ymm13, YMMWORD PTR YMM_FMA_TWOPOW1_MODF_HI 
	vmulpd	ymm3, ymm13, YMMWORD PTR YMM_FMA_TWOPOW1_MODF_LO
	vmulpd	ymm6, ymm13, YMMWORD PTR YMM_FMA_TWOPOW1_MODF_HIa 
	vmulpd	ymm7, ymm13, YMMWORD PTR YMM_FMA_TWOPOW1_MODF_LOa
	jmp	done

large_initial_value:

	vmovapd	ymm12, YMMWORD PTR YMM_FMA_INITVAL		
	vmovapd	ymm13, YMMWORD PTR YMM_FMA_RND_CONST1		

	yfmaddpd ymm0, ymm12, ymm2, ymm13			
	yfmaddpd ymm3, ymm12, ymm1, ymm14			
	yfmaddpd ymm4, ymm12, ymm6, ymm13			
	yfmaddpd ymm7, ymm12, ymm5, ymm14			
	vsubpd	ymm0, ymm0, ymm13				
	vsubpd	ymm3, ymm3, ymm14				
	vsubpd	ymm4, ymm4, ymm13				
	vsubpd	ymm7, ymm7, ymm14				
	yfmsubpd ymm2, ymm12, ymm2, ymm0			
	yfmsubpd ymm1, ymm12, ymm1, ymm3			
	yfmsubpd ymm6, ymm12, ymm6, ymm4			
	yfmsubpd ymm5, ymm12, ymm5, ymm7			
	vaddpd	ymm2, ymm2, ymm3				
	vaddpd	ymm6, ymm6, ymm7				
	yfmaddpd ymm3, ymm0, ymm8, ymm15			
	yfmaddpd ymm7, ymm4, ymm9, ymm15			
	vsubpd	ymm3, ymm3, ymm15				
	vsubpd	ymm7, ymm7, ymm15				
	yfnmaddpd ymm0, ymm3, ymm10, ymm0			
	yfnmaddpd ymm4, ymm7, ymm11, ymm4			
	vaddpd	ymm2, ymm2, ymm0				
	vaddpd	ymm6, ymm6, ymm4				
	yfnmaddpd ymm0, ymm3, YMMWORD PTR YMM_FMA_FAC_LO, ymm14	
	yfnmaddpd ymm4, ymm7, YMMWORD PTR YMM_FMA_FAC_LOa, ymm14
	vsubpd	ymm0, ymm0, ymm14				
	vsubpd	ymm4, ymm4, ymm14				
	vaddpd	ymm2, ymm2, ymm0				
	vaddpd	ymm6, ymm6, ymm4				
	yfnmsubpd ymm3, ymm3, YMMWORD PTR YMM_FMA_FAC_LO, ymm0	
	yfnmsubpd ymm7, ymm7, YMMWORD PTR YMM_FMA_FAC_LOa, ymm4	
	vaddpd	ymm3, ymm1, ymm3				
	vaddpd	ymm7, ymm5, ymm7				
	jmp	done

small_initial_value:
	vmovapd	ymm12, YMMWORD PTR YMM_FMA_INITVAL		
	yfmaddpd ymm1, ymm12, ymm8, ymm15			
	yfmaddpd ymm5, ymm12, ymm9, ymm15			
	vsubpd	ymm1, ymm1, ymm15				
	vsubpd	ymm5, ymm5, ymm15				
	yfnmaddpd ymm2, ymm1, ymm10, ymm12			
	yfnmaddpd ymm6, ymm5, ymm11, ymm12			
	yfnmaddpd ymm3, ymm1, ymm0, ymm14			
	yfnmaddpd ymm7, ymm5, ymm4, ymm14			
	vsubpd	ymm3, ymm3, ymm14				
	vsubpd	ymm7, ymm7, ymm14				
	vaddpd	ymm2, ymm2, ymm3				
	vaddpd	ymm6, ymm6, ymm7				
	yfnmsubpd ymm3, ymm1, ymm0, ymm3			
	yfnmsubpd ymm7, ymm5, ymm4, ymm7			

done:
	ENDM

avx_fma_fac MACRO fac_size

	vmovapd	ymm13, YMMWORD PTR YMM_FMA_RND_CONST0		
	yfmaddpd ymm0, ymm2, ymm2, ymm13			
	yfmaddpd ymm4, ymm6, ymm6, ymm13			

	vmovapd	ymm15, YMMWORD PTR YMM_FMA_RND_CONST1		
	yfmaddpd ymm1, ymm2, ymm3, ymm15			
	yfmaddpd ymm5, ymm6, ymm7, ymm15			

	vmovapd	ymm14, YMMWORD PTR YMM_FMA_RND_CONST2		
	yfmaddpd ymm8, ymm3, ymm3, ymm14			
	yfmaddpd ymm11, ymm7, ymm7, ymm14			

	vsubpd	ymm0, ymm0, ymm13				
	vsubpd	ymm4, ymm4, ymm13				

	mov	edx, FMA_SHIFTER[rdi*4-4]			

	vsubpd	ymm1, ymm1, ymm15				
	vsubpd	ymm5, ymm5, ymm15				

	vsubpd	ymm8, ymm8, ymm14				
	vsubpd	ymm11, ymm11, ymm14				

	yfmsubpd ymm9, ymm2, ymm2, ymm0				
	yfmsubpd ymm12, ymm6, ymm6, ymm4			

	yfmaddpd ymm10, ymm0, YMMWORD PTR YMM_FMA_TWOPOW1_MODF_HI[rdx], ymm15
								
	yfmaddpd ymm13, ymm4, YMMWORD PTR YMM_FMA_TWOPOW1_MODF_HIa[rdx], ymm15
								
	yfmsubpd ymm2, ymm2, ymm3, ymm1				
	yfmsubpd ymm6, ymm6, ymm7, ymm5				

	yfmsubpd ymm3, ymm3, ymm3, ymm8				
	yfmsubpd ymm7, ymm7, ymm7, ymm11			

	yfmaddpd ymm9, YMMWORD PTR YMM_FMA_TWO, ymm1, ymm9	
	yfmaddpd ymm12, YMMWORD PTR YMM_FMA_TWO, ymm5, ymm12	

	vsubpd	ymm10, ymm10, ymm15				
	vsubpd	ymm13, ymm13, ymm15				

	yfmaddpd ymm2, YMMWORD PTR YMM_FMA_TWO, ymm2, ymm8	
	yfmaddpd ymm6, YMMWORD PTR YMM_FMA_TWO, ymm6, ymm11	

	yfmaddpd ymm1, ymm0, YMMWORD PTR YMM_FMA_TWOPOW1_MODF_LO[rdx], ymm14 
	yfmaddpd ymm5, ymm4, YMMWORD PTR YMM_FMA_TWOPOW1_MODF_LOa[rdx], ymm14

	vmovapd ymm15, YMMWORD PTR [r8][rdx]			
	yfmaddpd ymm9, ymm15, ymm9, ymm10			
	yfmaddpd ymm12, ymm15, ymm12, ymm13			

	yfmsubpd ymm10, ymm0, YMMWORD PTR YMM_FMA_TWOPOW1_MODF_HI[rdx], ymm10
								
	yfmsubpd ymm13, ymm4, YMMWORD PTR YMM_FMA_TWOPOW1_MODF_HIa[rdx], ymm13
								
	vsubpd	ymm1, ymm1, ymm14				
	vsubpd	ymm5, ymm5, ymm14				

	vmovapd	ymm15, YMMWORD PTR YMM_FMA_RND_CONST3		
	yfmaddpd ymm8, ymm9, YMMWORD PTR YMM_FMA_INVFAC, ymm15	
	yfmaddpd ymm11, ymm12, YMMWORD PTR YMM_FMA_INVFACa, ymm15

	vmovapd ymm15, YMMWORD PTR [r8][rdx]			
	yfmaddpd ymm2, ymm15, ymm2, ymm10			
	yfmaddpd ymm6, ymm15, ymm6, ymm13			

	yfmsubpd ymm0, ymm0, YMMWORD PTR YMM_FMA_TWOPOW1_MODF_LO[rdx], ymm1
	yfmsubpd ymm4, ymm4, YMMWORD PTR YMM_FMA_TWOPOW1_MODF_LOa[rdx], ymm5

	vmovapd	ymm15, YMMWORD PTR YMM_FMA_RND_CONST3		
	vsubpd	ymm8, ymm8, ymm15				
	vsubpd	ymm11, ymm11, ymm15				

	vaddpd	ymm2, ymm2, ymm1				
	vaddpd	ymm6, ymm6, ymm5				

	vmovapd ymm15, YMMWORD PTR [r8][rdx]			
	yfmaddpd ymm3, ymm15, ymm3, ymm0			
	yfmaddpd ymm7, ymm15, ymm7, ymm4			

	vmovapd	ymm15, YMMWORD PTR YMM_FMA_RND_CONST2		
	yfnmaddpd ymm0, ymm8, YMMWORD PTR YMM_FMA_FAC_LO, ymm15	
	yfnmaddpd ymm4, ymm11, YMMWORD PTR YMM_FMA_FAC_LOa, ymm15

	yfnmaddpd ymm9, ymm8, YMMWORD PTR YMM_FMA_FAC_HI, ymm9	
	yfnmaddpd ymm12, ymm11, YMMWORD PTR YMM_FMA_FAC_HIa, ymm12

	vsubpd	ymm0, ymm0, ymm15				
	vsubpd	ymm4, ymm4, ymm15				

 	vaddpd	ymm2, ymm2, ymm9				
 	vaddpd	ymm6, ymm6, ymm12				

	yfnmsubpd ymm8, ymm8, YMMWORD PTR YMM_FMA_FAC_LO, ymm0	
	yfnmsubpd ymm11, ymm11, YMMWORD PTR YMM_FMA_FAC_LOa, ymm4

	vaddpd	ymm2, ymm2, ymm0				
	vaddpd	ymm6, ymm6, ymm4				

	vaddpd	ymm3, ymm3, ymm8				
	vaddpd	ymm7, ymm7, ymm11				
	ENDM

avx_fma_compare MACRO
	vaddpd	ymm2, ymm2, ymm3				
	vaddpd	ymm6, ymm6, ymm7
	ENDM

avx_fma_fac_initval MACRO avx_level
	LOCAL	large_initial_value, small_initial_value, equals_split, done

	vmovapd	ymm15, YMMWORD PTR YMM_FMA_RND_CONST3		
	vmovapd	ymm14, YMMWORD PTR YMM_FMA_RND_CONST2		
	lea	r8, YMM_FMA_ONE_OR_TWO				

	vmovapd	ymm13, YMMWORD PTR YMM_FMA_LOW_MASK		
	vandpd	ymm0, ymm13, YMMWORD PTR YMM_FMA_FAC_LO_INT	
	vandpd	ymm4, ymm13, YMMWORD PTR YMM_FMA_FAC_LO_INTa	
	vandpd	ymm8, ymm13, YMMWORD PTR YMM_FMA_FAC_LO_INTb	

	vorpd	ymm0, ymm0, ymm15				
	vorpd	ymm4, ymm4, ymm15				
	vorpd	ymm8, ymm8, ymm15				

	vorpd	ymm2, ymm15, YMMWORD PTR YMM_FMA_FAC_HI_INT	
	vorpd	ymm6, ymm15, YMMWORD PTR YMM_FMA_FAC_HI_INTa	
	vorpd	ymm10, ymm15, YMMWORD PTR YMM_FMA_FAC_HI_INTb	

	vmovapd	ymm13, YMMWORD PTR YMM_FMA_TWO_TO_LO		
	yfmsubpd ymm2, ymm2, ymm13, ymm14			
	yfmsubpd ymm6, ymm6, ymm13, ymm14			
	yfmsubpd ymm10, ymm10, ymm13, ymm14			

	vsubpd	ymm0, ymm0, ymm15				
	vsubpd	ymm4, ymm4, ymm15				
	vsubpd	ymm8, ymm8, ymm15				

	vmovapd	YMMWORD PTR YMM_FMA_FAC_HI, ymm2		
	vmovapd	YMMWORD PTR YMM_FMA_FAC_HIa, ymm6		
	vmovapd	YMMWORD PTR YMM_FMA_FAC_HIb, ymm10		

	vmovapd	YMMWORD PTR YMM_FMA_FAC_LO, ymm0		
	vmovapd	YMMWORD PTR YMM_FMA_FAC_LOa, ymm4		
	vmovapd	YMMWORD PTR YMM_FMA_FAC_LOb, ymm8		

	vaddpd	ymm3, ymm2, ymm0				
	vaddpd	ymm7, ymm6, ymm4				
	vaddpd	ymm11, ymm10, ymm8				
	vmovapd	ymm9, YMMWORD PTR YMM_FMA_ONE
	vdivpd	ymm1, ymm9, ymm3				
	vdivpd	ymm5, ymm9, ymm7				
	vdivpd	ymm9, ymm9, ymm11				
	vmovapd	YMMWORD PTR YMM_FMA_INVFAC, ymm1		
	vmovapd	YMMWORD PTR YMM_FMA_INVFACa, ymm5		
	vmovapd	YMMWORD PTR YMM_FMA_INVFACb, ymm9		

	vmovapd	ymm13, YMMWORD PTR YMM_FMA_RND_CONST4		
	vaddpd	ymm1, ymm1, ymm13				
	vaddpd	ymm5, ymm5, ymm13				
	vaddpd	ymm9, ymm9, ymm13				
	vsubpd	ymm1, ymm1, ymm13				
	vsubpd	ymm5, ymm5, ymm13				
	vsubpd	ymm9, ymm9, ymm13				
	vmovapd	ymm12, YMMWORD PTR YMM_FMA_ONE			
	yfnmaddpd ymm2, ymm1, ymm2, ymm12			
	yfnmaddpd ymm6, ymm5, ymm6, ymm12			
	yfnmaddpd ymm10, ymm9, ymm10, ymm12			
	vmovapd	ymm12, YMMWORD PTR YMM_FMA_RND_CONST5		
	yfnmaddpd ymm3, ymm1, ymm0, ymm12			
	yfnmaddpd ymm7, ymm5, ymm4, ymm12			
	yfnmaddpd ymm11, ymm9, ymm8, ymm12			
	vsubpd	ymm3, ymm3, ymm12				
	vsubpd	ymm7, ymm7, ymm12				
	vsubpd	ymm11, ymm11, ymm12				
	vaddpd	ymm2, ymm2, ymm3				
	vaddpd	ymm6, ymm6, ymm7				
	vaddpd	ymm10, ymm10, ymm11				
	yfnmsubpd ymm1, ymm1, ymm0, ymm3			
	yfnmsubpd ymm5, ymm5, ymm4, ymm7			
	yfnmsubpd ymm9, ymm9, ymm8, ymm11			
	vmovapd	YMMWORD PTR YMM_FMA_TWOPOW1_MODF_HI, ymm2	
	vmovapd	YMMWORD PTR YMM_FMA_TWOPOW1_MODF_HIa, ymm6	
	vmovapd	YMMWORD PTR YMM_FMA_TWOPOW1_MODF_HIb, ymm10	
	vmovapd	YMMWORD PTR YMM_FMA_TWOPOW1_MODF_LO, ymm1	
	vmovapd	YMMWORD PTR YMM_FMA_TWOPOW1_MODF_LOa, ymm5	
	vmovapd	YMMWORD PTR YMM_FMA_TWOPOW1_MODF_LOb, ymm9	

	vmovapd	ymm12, YMMWORD PTR YMM_FMA_TWO			
	yfmaddpd ymm1, ymm12, YMMWORD PTR YMM_FMA_INVFAC, ymm13	
	yfmaddpd ymm5, ymm12, YMMWORD PTR YMM_FMA_INVFACa, ymm13
	yfmaddpd ymm9, ymm12, YMMWORD PTR YMM_FMA_INVFACb, ymm13
	vsubpd	ymm1, ymm1, ymm13				
	vsubpd	ymm5, ymm5, ymm13				
	vsubpd	ymm9, ymm9, ymm13				
	yfnmaddpd ymm2, ymm1, YMMWORD PTR YMM_FMA_FAC_HI, ymm12	
	yfnmaddpd ymm6, ymm5, YMMWORD PTR YMM_FMA_FAC_HIa, ymm12
	yfnmaddpd ymm10, ymm9, YMMWORD PTR YMM_FMA_FAC_HIb, ymm12
	vmovapd	ymm12, YMMWORD PTR YMM_FMA_RND_CONST5		
	yfnmaddpd ymm3, ymm1, ymm0, ymm12			
	yfnmaddpd ymm7, ymm5, ymm4, ymm12			
	yfnmaddpd ymm11, ymm9, ymm8, ymm12			
